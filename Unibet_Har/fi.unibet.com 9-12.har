            "text": "{\"id\":\"21ba1060-7339-437f-8317-a43f53f3fb37\",\"version\":\"1016002\",\"json\":{\"IDENTITY\":{\"normal\":{\"title\":\"Vahvista henkilöllisyytesi\",\"description\":\"Vahvista henkilötietosi, jotta voit jatkaa tilisi käyttöä ja pelata ilman keskeytyksiä. <ifCountdown>Vahvista tietosi seuraavan {days} päivän kuluessa.</ifCountdown>\",\"button\":\"Vahvista henkilötiedot\"},\"restricted\":{\"title\":\"Vahvista henkilöllisyytesi\",\"description\":\"Vahvista henkilötietosi, jotta saat täyden pääsyn tilillesi ja voit pelata ilman keskeytyksiä. <ifCountdown>Vahvista tietosi seuraavan {days} päivän kuluessa.</ifCountdown>\",\"button\":\"Vahvista henkilötiedot\"},\"blocked\":{\"title\":\"Pelitilisi on estetty\",\"description\":\"Vahvista henkilötietosi, jotta saat pelitilisi auki ja voit jatkaa pelaamista.\",\"button\":\"Vahvista henkilötiedot\"}},\"PERSONAL\":{\"normal\":{\"title\":\"Vahvista varallisuutesi\",\"description\":\"Kestävän pelikokemuksen varmistamiseksi pyydämme pelaajia varmistamaan tulolähteensä. <ifCountdown>Vahvista tietosi seuraavan {days} päivän kuluessa jatkaaksesi pelaamista.</ifCountdown>\",\"button\":\"Vahvista tulot\"},\"restricted\":{\"title\":\"Vahvista varallisuutesi\",\"description\":\"Pyydämme pelaajiamme vahvistamaan tulolähteensä saadakseen täyden pääsyn tililleen. <ifCountdown>Vahvista tietosi seuraavan {days} päivän kuluessa jatkaaksesi pelaamista.</ifCountdown>\",\"button\":\"Vahvista tulot\"},\"blocked\":{\"title\":\"Pelitilisi on estetty\",\"description\":\"Vahvista tulolähteesi avataksesi tilisi ja jatkaaksesi pelaamista.\",\"button\":\"Vahvista tulot\"}},\"PAYMENT\":{\"normal\":{\"title\":\"Vahvista maksutietosi\",\"description\":\"Vahvista maksutietosi, jotta pääset käyttämään tiliäsi ja pelaamaan ilman keskeytyksiä.\",\"button\":\"Vahvista maksutiedot\"}},\"MULTIPLE\":{\"normal\":{\"title\":\"Sinulla on vahvistuksia odottamassa\",\"description\":\"Turvallisen ja sujuvan pelikokemuksen varmistamiseksi on tärkeää, että tietosi vahvistetaan. Siirry vahvistussivulle suorittaaksesi kaikki odottavat pyynnöt.\",\"button\":\"Vahvistussivulle\"}},\"secureBanner\":{\"title\":\"Olet suojatulla sivustolla.\",\"moreInformation\":\"Kaikki henkilötietosi tallennetaan salatussa ja suojatussa muodossa. Käytämme asiakirjojasi vain tunnistaaksemme sinut oikeudellisista syistä.\"}},\"moduleId\":\"verification-notifications\"}"
          },
