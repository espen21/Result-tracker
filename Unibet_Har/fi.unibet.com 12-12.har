          "content": {
            "size": 8697,
            "mimeType": "application/json",
            "text": "{\n\t\"FORGOT_PASSWORD\": {\n\t\t\"FORM\": {\n\t\t\t\"Title\": \"Unohditko salasanasi?\",\n\t\t\t\"Description\": \"Anna sähköpostiosoitteesi, jolla olet rekisteröinyt {brandName}-tilisi, niin lähetämme sinulle linkin, jolla voit vaihtaa salasanasi.\",\n\t\t\t\"Label\": \"Käyttäjänimi / sähköpostiosoite\",\n\t\t\t\"CTAButton\": \"Lähetä linkki\"\n\t\t},\n\t\t\"SUCCESS_MESSAGE\": {\n\t\t\t\"Title\": \"Kurkkaa sähköpostisi\",\n\t\t\t\"Description1\": \"Eikö sähköpostia kuulu? \",\n\t\t\t\"Description2\": \"Kurkkaathan myös roskapostikansiosi.\",\n\t\t\t\"Description3\": \"Yhä jumissa? \",\n\t\t\t\"Description4\": \"Ehkä tilisi ei ole enää aktiivinen tai annoit sähköpostin, joka ei ole rekisteröity pelitiliisi.\",\n\t\t\t\"CTAButton\": \"Pyydä apua pelitilille pääsyssä\"\n\t\t},\n\t\t\"ERROR\": {\n\t\t\t\"invalidEmail\": \"Virheellinen sähköposti. Yritä uudelleen.\"\n\t\t}\n\t},\n\t\"RESET_PASSWORD\": {\n\t\t\"FORM\": {\n\t\t\t\"Title\": \"Anna uusi salasana\",\n\t\t\t\"Label\": \"Uusi salasanasi\",\n\t\t\t\"Microcopy\": \"Kirjoita vähintään 8 merkkiä, joista vähintään 1 pieni kirjain, 1 iso kirjain, 1 numero ja 1 erikoismerkki. Älä käytä nimeäsi, syntymäaikaasi tai sanaa {brandName}.\",\n\t\t\t\"CTAButton\": \"Vaihda salasana\",\n\t\t\t\"confirmPassword\": \"Vahvista salasana\",\n\t\t\t\"passwordMismatch\": \"Varmistathan, että salasanasi täsmää\"\n\t\t},\n\t\t\"SUCCESS_MESSAGE\": {\n\t\t\t\"Title\": \"Salasanasi on vaihdettu\",\n\t\t\t\"Description\": \"Käytäthän uutta salasanaasi kirjautuaksesi sisään.\",\n\t\t\t\"CTAButton\": \"Kirjaudu sisään\"\n\t\t},\n\t\t\"INVALID_TOKEN\": {\n\t\t\t\"Title\": \"Linkkisi on vanhentunut\",\n\t\t\t\"Description\": \"Pahoittelut, et voi enää käyttää tätä linkkiä vaihtaaksesi salasanasi.\",\n\t\t\t\"Description2\": \"Haluatko yhä vaihtaa salasanasi? Pyydäthän uuden linkin.\",\n\t\t\t\"CTA\": \"Vaihda salasanasi\"\n\t\t},\n\t\t\"OTP_WRAPPER\": {\n\t\t\t\"SMS\": {\n\t\t\t\t\"Title\": \"Vahvista matkapuhelinnumero\",\n\t\t\t\t\"Description\": \"Salasanan vaihtamista varten\"\n\t\t\t}\n\t\t},\n\t\t\"VALIDATION_ERRORS\": {\n\t\t\t\"PASSWORD_RESET_TOKEN_NOT_FOUND\": \"Pelitilin vahvistuksessa tapahtui virhe.\",\n\t\t\t\"UNKNOWN_ERROR\": \"Tapahtui tuntematon virhe\",\n\t\t\t\"PASSWORD_INVALID_PATTERN\": \"Salasana on virheellinen. Kirjoita vähintään 8 merkkiä, joista vähintään 1 pieni kirjain, 1 iso kirjain, 1 numero ja 1 erikoismerkki. Älä käytä nimeäsi, syntymäaikaasi tai sanaa {brandName}.\",\n\t\t\t\"PASSWORD_REJECTED\": \"Uusi salasana ei voi olla sama kuin vanha salasana\",\n\t\t\t\"MIN_LENGTH\": \"Vähimmäispituus ei täyty\",\n\t\t\t\"UPPERCASE\": \"Vähintään 1 iso kirjain vaaditaan\",\n\t\t\t\"LOWERCASE\": \"Vähintään 1 pieni kirjain vaaditaan\",\n\t\t\t\"SPECIAL_CHARACTER\": \"Vähintään 1 erikoismerkki vaaditaan\",\n\t\t\t\"MAX_LENGTH\": \"Maksimipituus ylitetty\"\n\t\t}\n\t},\n\t\"BLOCKED_MESSAGE\": {\n\t\t\"BLOCKED_SELF_EXCLUSION\": \"Olet estänyt itseltäsi pelaamisen. Et valitettavasti pysty kirjautumaan sisään ennen kuin estoaikasi päättyy.\",\n\t\t\"CUSTOMER_ACCOUNT_CLOSURE\": \"Olemme pahoillamme, sisäänkirjautumisesi on tällä hetkellä estetty.\",\n\t\t\"UNKNOWN_ERROR\": \"Tapahtui virhe, yritä hetken kuluttua uudelleen. Jos ongelma jatkuu, ota meihin yhteyttä.\",\n\t\t\"DEFAULT\": \"Olemme pahoillamme, sisäänkirjautumisesi on tällä hetkellä estetty.\"\n\t},\n\t\"BACK_TO_LOGIN\": \"Takaisin\",\n\t\"LOGIN\": {\n\t\t\"ERROR_MESSAGE\": {\n\t\t\t\"accountClosedErrorMess\": \"Pelitilisi on väliaikaisesti suljettu. Mikäli haluat avata pelitilisi, olethan <ContactLink>meihin yhteydessä.</ContactLink>\",\n\t\t\t\"passwordExpiredErrorMess\": \"Salasanasi on vanhentunut. Kirjautuaksesi sisään, <ResetPasswordLink>päivitäthän salasanasi</ResetPasswordLink>.\",\n\t\t\t\"blockedByRegulatorInvalidLoginType\": \"Valitsemasi kirjautumistapa ei ole saatavilla. Valitse toinen kirjautumistapa ja yritä uudelleen.\",\n\t\t\t\"rateLimitedErrorMess\": \"Tilisi ei ole saatavilla juuri nyt. Ole hyvä ja ota meihin yhteyttä, jos ongelma jatkuu.\",\n\t\t\t\"blockedByRegulatorAgeValidation\": \"Your account is currently unavailable. Please contact us if this problem persists.\",\n\t\t\t\"acctPermanentlyBlockedErrorMess\": \"Tilisi on nyt lukittu 15 virheellisen salasanayrityksen vuoksi.  <GetHelpLink>Pyydä apua tilin avaamiseen.</GetHelpLink>\",\n\t\t\t\"otherLoginFailureErrorMess\": \"Tilisi ei tällä hetkellä ole käytettävissä. <AccountBlockedOpenInDefault>Lue lisää</AccountBlockedOpenInDefault>\",\n\t\t\t\"blockedByRegulator\": \"Tilisi ei ole tällä hetkellä käytettävissä. Otathan meihin yhteyttä, mikäli ongelma jatkuu.\",\n\t\t\t\"takeABreakErrorMess\": \"Näyttää siltä, että olet tauolla. Tilisi aktivoituu uudelleen, kun taukojakso on ohi.\",\n\t\t\t\"selfExclusionInCoolingOffPeriod\": \"Your account is still in the 24 hour cooling off period from being reactivated after your self-exclusion. Please try again shortly.\",\n\t\t\t\"indefiniteSelfExclusionInCoolingOffPeriod\": \"Your account has been reactivated after your self-exclusion, but you are unable to access it until the end of a 7-day cooling off period. You can access your account from {selfExclusionDate}.\",\n\t\t\t\"inputErrorMess\": \"Pahoittelut, emme tunnista tietojasi. Tarkistathan salasanasi ja sähköpostiosoitteesi ja yritä sitten uudelleen. Etkö ole varma tiedoistasi? <ResetPasswordLink>Vaihda salasanasi</ResetPasswordLink> tai <GetHelpLink>pyydä apua sisäänkirjautumisessa</GetHelpLink>\",\n\t\t\t\"manyAttemptsErrorMess\": \"Tilisi lukittuu viiden virheellisen salasanayrityksen jälkeen. Oletko unohtanut kirjautumistietosi? <ResetPasswordLink>Vaihda salasanasi</ResetPasswordLink> tai <GetHelpLink>pyydä apua sisäänkirjautumisessa</GetHelpLink>\",\n\t\t\t\"tooManyAttemptsErrorMess\": \"Tilisi on tilapäisesti lukittu liian monen salasanayrityksen vuoksi. <ResetPasswordLink>Vaihda salasanasi</ResetPasswordLink> avataksesi tilisi tai <GetHelpLink>pyydä apua.</GetHelpLink>\",\n\t\t\t\"sessionLimitErrorMess\": \"You've reached your session limit and cannot log in again until the limit renews. Please try again later.\",\n\t\t\t\"sessionLimitErrorMessComplement\": \" \",\n\t\t\t\"blockedErrorMess\": \"Tilisi käyttö on estetty. <AccountBlocked>Lue lisää.</AccountBlocked>\",\n\t\t\t\"selfExclusionErrorMess\": \"Tilillesi on asetettu itse-esto. Et pysty kirjautumaan tai aktivoimaan tiliäsi uudelleen ennen {selfExclusionEndDate}. Jos haluat kotiuttaa pelitililläsi olevat varat, olethan <GetHelpLink>meihin yhteydessä.</GetHelpLink>\",\n\t\t\t\"selfExclusionWithoutDate\": \"Sinulla on itse-esto päällä. Et voi kirjautua kunnes itse-esto -ajanjaksosi päättyy. <GetHelpLink>Lue lisää.</GetHelpLink>\",\n\t\t\t\"selfExclusionActionNeeded\": \"Your self-exclusion period has now ended, and you can reactivate your account with us whenever you choose.\",\n\t\t\t\"crossSiteLoginErrorMess\": \"Kirjaudu {brandName}-tilillesi siirtymällä osoitteeseen: <CrossSiteLoginLink>{customerMarket}</CrossSiteLoginLink>\",\n\t\t\t\"crossSiteErrorWithoutLink\": \"Nykyinen sivusto ei salli sivustojen välistä kirjautumista.\",\n\t\t\t\"indefiniteSelfExclusionActionNeeded\": \"Tilillesi on asetettu määrittelemätön itse-esto. Jos haluat aktivoida tilisi uudelleen tai kotiuttaa varasi, olethan <GetHelpLink>meihin yhteydessä.</GetHelpLink>\",\n\t\t\t\"clientNotAllowed\": \"Kirjautuminen evätty, asiakas ei sallittu.\"\n\t\t},\n\t\t\"forgottenPassword\": \"Unohditko salasanasi?\",\n\t\t\"notUserNameLinkInfo\": \"Klikkaa tästä mikäli et ole kyseinen käyttäjä\",\n\t\t\"notYou\": \"Eri käyttäjätunnus?\",\n\t\t\"login\": \"Kirjaudu sisään\",\n\t\t\"notCustomerQuestion\": \"Eikö sinulla ole vielä tiliä?\",\n\t\t\"not\": \"Ei\",\n\t\t\"password\": \"Salasana\",\n\t\t\"show\": \"Näytä\",\n\t\t\"hide\": \"Piilota\",\n\t\t\"forgottenUserName\": \"Unohtuiko käyttäjätunnus?\",\n\t\t\"label\": \"Salasana\",\n\t\t\"userName\": \"Sähköpostiosoite\",\n\t\t\"captchaRequired\": \"Please verify that you are not a robot\",\n\t\t\"rememberMe\": \"Muista tietoni\",\n\t\t\"forgot\": \"Unohtui?\",\n\t\t\"register\": \"Rekisteröidy\",\n\t\t\"notYourLanguage\": \"Väärä kieli?\",\n\t\t\"loginButton\": \"Kirjaudu\",\n\t\t\"registerButton\": \"Rekisteröidy\",\n\t\t\"InputvalidationError\": \"Syötä vähintään {minLength} merkkiä.\",\n\t\t\"loggingIn\": \"Kirjaudutaan sisään\"\n\t},\n\t\"LOGOUT\": {\n\t\t\"logoutButton\": \"Kirjaudu ulos\"\n\t},\n\t\"REDIRECT_LOGIN\": {\n\t\t\"Title\": \"HEI, TUNNEMMEKO SINUT?\",\n\t\t\"ResetPassword\": \"Vaihda salasana\"\n\t},\n\t\"REOPEN_ACCOUNT\": {\n\t\t\"MODAL\": {\n\t\t\t\"title\": \"Tervetuloa takaisin {firstName}!\",\n\t\t\t\"descriptionForStep\": \"Tilisi on tällä hetkellä <bold>jäädytettynä</bold>. Mutta älä huoli - sen avaaminen uudelleen on todella helppoa.\",\n\t\t\t\"step\": \"Vaihe {step}\",\n\t\t\t\"stepTitle1\": \"Vahvista tilisi\",\n\t\t\t\"stepDescription1\": \"Vahvista henkilöllisyytesi sähköpostitse tai tekstiviestillä, jotta tilisi pysyy turvassa.\",\n\t\t\t\"stepTitle2\": \"Tarkista henkilökohtaiset tietosi\",\n\t\t\t\"stepDescription2\": \"Varmista, että tietosi ovat ajan tasalla.\",\n\t\t\t\"stepTitle3\": \"Aloita pelaaminen uudelleen\",\n\t\t\t\"stepDescription3\": \"Nauti urheiluvedonlyönnistä, pokerin pelaamisesta tai kokeile onneasi kasinolla.\",\n\t\t\t\"reopenAccountButton\": \"Avaa tili uudelleen\"\n\t\t}\n\t}\n}"
          },
