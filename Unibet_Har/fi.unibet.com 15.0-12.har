            "text": "{\"id\":\"236a1589-c57c-4e7e-87dd-4e20f5dddc24\",\"version\":\"1090000\",\"json\":{\"brand_name\":{\"32red\":\"32Red\",\"bingo_com\":\"Bingo.com\",\"bohemia\":\"Bohemia Casino\",\"highroller\":\"Highroller\",\"huone\":\"Casinohuone\",\"igame\":\"iGame\",\"kolikkopelit\":\"Kolikkopelit\",\"maria\":\"Maria Casino\",\"ottokasino\":\"Otto Kasino\",\"unibet\":\"Unibet\",\"unibetcasino\":\"Unibet Casino\",\"unibetgames\":\"Unibet Games\",\"vanillacasino\":\"Vanilla Casino\",\"vladcazino\":\"Vlad Cazino\"},\"days_to_start\":\"{days} päivää alkuun\",\"ended\":\"Päättynyt\",\"ends\":\"Päättyy\",\"ends_in\":\"Päättyy\",\"game_in_tournament\":\"Peliä turnauksessa\",\"games_in_tournament\":\"peliä mukana turnauksessa\",\"general_error\":\"Jotakin meni vikaan.\",\"general_fetch_error\":\"Jotakin meni vikaan. Yritäthän ladata sivun uudestaan.\",\"go_to_tournaments\":\"Mene turnauksiin\",\"goalCriteriaTandC\":{\"BINGO_POINTS_PER_LINE\":\"\",\"CASINO_BEST_EQUALIZED_CONSECUTIVE\":\"\",\"CASINO_BEST_NETWIN_CONSECUTIVE\":\"\",\"CASINO_GAME_ROUNDS_PLAYED\":\"\",\"CASINO_TOTAL_TURNOVER\":\"\"},\"hours_to_start\":\"{hours} tuntia alkuun\",\"leaderboard\":\"Tulostaulukko\",\"login_and_optin\":\"Kirjaudu ja osallistu\",\"min_amount\":\"minimipanos\",\"min_consecutive_rounds\":\"Peräkkäistä kierrosta vaaditaan\",\"min_round\":\"Minimikierrokset\",\"mins_to_start\":\"{minutes} minuuttia alkuun\",\"no_active_tournaments\":\"Ei aktiivisia turnauksia tällä hetkellä\\n\\nKatso myöhemmin uudelleen!\",\"no_finished_tournaments\":\"Ei päättyneitä turnauksia tällä hetkellä.\",\"no_opt_in\":\"Et osallistunut tähän turnaukseen\",\"no_upcoming_tournaments\":\"Ei tulevia turnauksia tällä hetkellä\\n\\nKatso myöhemmin uudelleen!\",\"ongoing\":\"Käynnissä\",\"opt_in\":\"Osallistu\",\"opt_in_failure\":\"Osallistumisessasi tapahtui virhe, kokeilethan uudestaan.\",\"opt_in_success\":\"Olet mukana turnauksessa. Onnea peleihin!\",\"place\":\"Sija\",\"prize\":\"Palkinto\",\"prizePool\":\"Palkintopotti\",\"prizes\":\"Palkinnot\",\"product_filter\":{\"all\":\"Kaikki turnaukset\",\"bingo\":\"Bingo\",\"casino\":\"Casino\"},\"score\":\"Tulos\",\"see_leaders\":\"Katso pistetaulukon kärki\",\"see_more_tournaments\":\"Lisää turnauksia\",\"see_winners\":\"Katso voittajat\",\"see_your_position\":\"Palaa sijoitukseesi\",\"shortDays\":\"pv\",\"shortHours\":\"t\",\"shortMinutes\":\"min\",\"show_less\":\"Näytä vähemmän\",\"show_more\":\"Näytä enemmän\",\"significant_T&C\":\"'<p>'Sinun tulee pelata vähintään {minNumberOfRounds} kierrosta ollaksesi mukana turnauksessa, joka alkaa {startDateTime} ja päättyy {endDateTime}.'</p>'\\r\\n\",\"started\":\"Alkanut\",\"starts\":\"Alkaa\",\"starts_in\":\"Alkaa\",\"t&C_apply\":\"Säännöt ja ehdot\",\"topPrize\":\"Pääpalkinto\",\"top_place_limit\":\"Sinun tulee olla top {topPlaceLimit} nähdäksesi sijoituksesi\",\"tournament_explanation\":\"Kuinka turnaus toimii?\",\"tournament_explanation_link\":\"Find all your answers here\",\"tournament_game\":\"turnauspeli\",\"tournament_games\":\"turnauspelit\",\"tournament_header\":\"Turnaukset\",\"tournament_header_description\":\"Turnauksemme ovat erinomainen tapa tavoitella palkintoja samalla kun nautit lempipeleistäsi! Nappaatko suurimman voiton, pelaatko eniten kierroksia tai saatko panoksellesi suurimman kerroinvoiton? Löydät tulevat, käynnissä olevat ja päättyneet turnaukset alla olevasta aikataulusta:\",\"tournament_info\":{\"best_consecutive_spin\":{\"message\":\"Pisteesi koostuvat {numberOfConsecutiveRounds} parhaasta peräkkäisestä kierroksesta. <HowToPlayLink>Lue lisätietoja</HowToPlayLink>.\",\"title\":\"Peräkkäisten kierrosten turnaus\"},\"best_consecutive_spin_net_win\":{\"message\":\"Tuloksesi on nettovoitto {numberOfConsecutiveRounds} parhaalta peräkkäiseltä kierrokseltasi. <HowToPlayLink>Lue lisätietoja</HowToPlayLink>.\",\"title\":\"Peräkkäisten kierrosten turnaus (nettovoitto)\"},\"bingo_points_per_line\":{\"message\":\"Tuloksesi on voitettujen pisteiden summa. <HowToPlayLink>Lue lisätietoja</HowToPlayLink>.\",\"title\":\"Bingoturnaus\"},\"most_rounds_wins\":{\"message\":\"Tulos pohjautuu pelattujen kierrosten määrään. Eniten kierroksia pelannut pelaaja voittaa turnauksen. <HowToPlayLink>Lue lisätietoja</HowToPlayLink>.\",\"title\":\"Suurin kierrosmäärä\"},\"one_lucky_spin\":{\"message\":\"Tuloksesi on suurin tasoitettu voitto yhdeltä kierrokselta, kerrottuna sadalla. <HowToPlayLink>Lue lisätietoja</HowToPlayLink>.\",\"title\":\"Onnenkierrosturnaus\"},\"one_lucky_spin_net_win\":{\"message\":\"Tuloksesi on paras nettovoittosi yhdellä kierroksella. <HowToPlayLink>Lue lisätietoja</HowToPlayLink>.\",\"title\":\"Onnenkierrosturnaus (nettovoitto)\"},\"turnover\":{\"message\":\"Saat pisteen jokaisesta panostamastasi eurosta. <HowToPlayLink>Lue lisätietoja</HowToPlayLink>.\",\"title\":\"Kierrätysturnaus\"}},\"tournament_state\":{\"active\":\"Käynnissä\",\"finished\":\"Päättynyt\",\"upcoming\":\"Tulossa\"},\"tournament_state_change_msg\":{\"active\":\"Tämä turnaus on nyt alkanut\",\"finished\":\"Tämä turnaus on nyt päättynyt\"},\"you\":\"Sinä\",\"you_won\":\"Onneksi olkoon! Voitit {userPrize}!\"},\"moduleId\":\"tournament\"}"
