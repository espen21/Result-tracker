1.844771\",\"isReferenceContract\":false,\"appliedView\":\"teaser\",\"isVelocityEnabled\":true},\"categories\":{\"contractInvalid\":false,\"contractType\":\"com.unibet.cms.contract.top.MetadataContract\",\"entities\":[]},\"amountOfLinks\":10000,\"theme\":\"no box\",\"isPersonalized\":false,\"contentIdString\":\"1.860550\",\"isReferenceContract\":false,\"appliedView\":\"teaser\",\"isVelocityEnabled\":true},{\"self\":\"/onecms/proxy/content/contentid/policy:1.781517\",\"contractInvalid\":false,\"contractType\":\"com.unibet.cms.contract.top.ArticleContract\",\"containingKmfEnabledContent\":false,\"name\":\"Hankkiudu eroon pahoista pokeritavoistasi\",\"url\":\"https://fi.unibet.com/poker/guides/hankkiudu-eroon-pahoista-pokeritavoistasi-1.781517\",\"leadInText\":\"Monilla ihmisillä voi olla vaikeuksia muuttaa tapojaan, ja usein tämä johtuu siitä, että muutoksen tarvetta on vaikea nähdä. Mikään ei muutu ilman motivaatiota muuttaa asioita paremmaksi. Tapaamme jäädä helposti kiinni samoihin käyttäytymismalleihin, vaikka ne johtaisivat aina huonoihin lopputuloksiin.\",\"publishedDateTime\":1461308196000,\"image\":{\"name\":\"teaser_poker\",\"contentId\":\"contentid/1.533271\",\"self\":\"/onecms/proxy/content/contentid/policy:1.533271\",\"contractInvalid\":false,\"contractType\":\"com.unibet.cms.contract.top.ImageContract\",\"containingKmfEnabledContent\":false,\"title\":\"teaser_poker\",\"url\":\"https://fi.unibet.com/polopoly_fs/1.533271.1482141827!/image/2314855773.png\",\"imageLink\":\"/polopoly_fs/1.533271.1482141827!/image/2314855773.png\",\"contentIdString\":\"1.533271\",\"isReferenceContract\":false,\"appliedView\":\"teaser\",\"isVelocityEnabled\":true},\"categories\":{\"contractInvalid\":false,\"contractType\":\"com.unibet.cms.contract.top.MetadataContract\",\"entities\":[{\"name\":\"Poker\",\"id\":\"department.categorydimension.subject.poker\",\"dimensionName\":\"Subjects\",\"dimensionId\":\"department.categorydimension.subject\",\"url\":\"poker\"}]},\"amountOfLinks\":10000,\"theme\":\"no box\",\"isPersonalized\":false,\"contentIdString\":\"1.781517\",\"isReferenceContract\":false,\"appliedView\":\"teaser\",\"isVelocityEnabled\":true},{\"self\":\"/onecms/proxy/content/contentid/policy:1.733726\",\"contractInvalid\":false,\"contractType\":\"com.unibet.cms.contract.top.ArticleContract\",\"containingKmfEnabledContent\":false,\"name\":\"Kuinka tulla paremmaksi nettipokerissa? \",\"url\":\"https://fi.unibet.com/poker/guides/kuinka-tulla-paremmaksi-nettipokerissa-1.733726\",\"leadInText\":\"Olet varmaankin kuullut vanhan sanonnan, jonka mukaan pokerin oppii hetkessä, mutta pelin todellinen hallitseminen kestää eliniän. Tämä on totta, sillä nettipokerissa paremmaksi tuleminen vaatii paljon harjoittelua ja kokemuksen kartuttamista. Oikeanlaisella opiskelulla ja vinkkejä käyttäen sinusta voi kuitenkin tulla parempi peluri lyhyemmässä ajassa, vaikka alottaisit ilman minkäänlaista taustatietoa.\",\"lead\":\"\\u003cp\\u003eOlet varmaankin kuullut vanhan sanonnan, jonka mukaan pokerin oppii hetkessä, mutta pelin todellinen hallitseminen kestää eliniän. Tämä on totta, sillä nettipokerissa paremmaksi tuleminen vaatii paljon harjoittelua ja kokemuksen kartuttamista. Jos kuitenkin opiskelet oikein ja käytät vinkkejä pelaamisessasi, sinusta voi tulla parempi peluri lyhyemmässä ajassa, vaikka alottaisit ilman minkäänlaista taustatietoa.\\u003c/p\\u003e\\r\\n\",\"publishedDateTime\":1450451514000,\"image\":{\"name\":\"tile-getting-better\",\"contentId\":\"contentid/1.696151\",\"self\":\"/onecms/proxy/content/contentid/policy:1.696151\",\"contractInvalid\":false,\"contractType\":\"com.unibet.cms.contract.top.ImageContract\",\"containingKmfEnabledContent\":false,\"title\":\"tile-getting-better\",\"url\":\"https://fi.unibet.com/polopoly_fs/1.696151.1482141230!/image/3374961481.jpg\",\"imageLink\":\"/polopoly_fs/1.696151.1482141230!/image/3374961481.jpg\",\"contentIdString\":\"1.696151\",\"isReferenceContract\":false,\"appliedView\":\"teaser\",\"isVelocityEnabled\":true},\"categories\":{\"contractInvalid\":false,\"contractType\":\"com.unibet.cms.contract.top.MetadataContract\",\"entities\":[{\"name\":\"Poker\",\"id\":\"department.categorydimension.subject.poker\",\"dimensionName\":\"Subjects\",\"dimensionId\":\"department.categorydimension.subject\",\"url\":\"poker\"}]},\"amountOfLinks\":10000,\"theme\":\"no box\",\"isPersonalized\":false,\"contentIdString\":\"1.733726\",\"isReferenceContract\":false,\"appliedView\":\"teaser\",\"isVelocityEnabled\":true},{\"self\":\"/onecms/proxy/content/contentid/policy:1.734297\",\"contractInvalid\":false,\"contractType\":\"com.unibet.cms.contract.top.ArticleContract\",\"containingKmfEnabledContent\":false,\"name\":\"Lue pokerikäsien rankingista ja lataa lunttilappu\",\"url\":\"https://fi.unibet.com/poker/guides/lue-pokerik%C3%A4sien-rankingista-ja-lataa-lunttilappu-1.734297\",\"leadInText\":\"Pokerin säännöt ovat yksinkertaiset, ja pokerikäsien rankingit varsin selkeät. Sinulla voi olla 10 erilaista kättä. Arvokkain käsistä on kuningasvärisuora, ja heikoin hai. Jos etsit tietoa siitä, mitä käsiä kannattaa pelata ja mitä ei, tsekkaa oppaamme aloituskäsistä, josta löydät toisen lunttilapun.\",\"lead\":\"\\u003cp\\u003e\\u003cspan style\\u003d\\\"font-size: 11pt; line-height: 105%; font-family: Calibri, sans-serif;\\\"\\u003eOlet varmaankin kuullut vanhan sanonnan, jonka mukaan pokerin oppii hetkessä, mutta pelin todellinen hallitseminen kestää eliniän. Tämä on totta, sillä nettipokerissa paremmaksi tuleminen vaatii paljon harjoittelua ja kokemuksen kartuttamista. Oikeanlaisella opiskelulla ja vinkkejä käyttäen sinusta voi kuitenkin tulla parempi peluri lyhyemmässä ajassa, vaikka alottaisit ilman minkäänlaista taustatietoa.\\u003c/span\\u003e\\u003c/p\\u003e\\r\\n\",\"publishedDateTime\":1450773344000,\"image\":{\"name\":\"tile-cheat-sheet\",\"contentId\":\"contentid/1.696150\",\"self\":\"/onecms/proxy/content/contentid/policy:1.696150\",\"contractInvalid\":false,\"contractType\":\"com.unibet.cms.contract.top.ImageContract\",\"containingKmfEnabledContent\":false,\"title\":\"tile-cheat-sheet\",\"url\":\"https://fi.unibet.com/polopoly_fs/1.696150.1482141230!/image/1594664195.jpg\",\"imageLink\":\"/polopoly_fs/1.696150.1482141230!/image/1594664195.jpg\",\"contentIdString\":\"1.696150\",\"isReferenceContract\":false,\"appliedView\":\"teaser\",\"isVelocityEnabled\":true},\"categories\":{\"contractInvalid\":false,\"contractType\":\"com.unibet.cms.contract.top.MetadataContract\",\"entities\":[{\"name\":\"Poker\",\"id\":\"department.categorydimension.subject.poker\",\"dimensionName\":\"Subjects\",\"dimensionId\":\"department.categorydimension.subject\",\"url\":\"poker\"}]},\"amountOfLinks\":10000,\"theme\":\"no box\",\"isPersonalized\":false,\"contentIdString\":\"1.734297\",\"isReferenceContract\":false,\"appliedView\":\"teaser\",\"isVelocityEnabled\":true},{\"self\":\"/onecms/proxy/content/contentid/policy:1.734306\",\"contractInvalid\":false,\"contractType\":\"com.unibet.cms.contract.top.ArticleContract\",\"containingKmfEnabledContent\":false,\"name\":\"Mitä pokerikäsiä minun tulisi pelata ja miksi?\",\"url\":\"https://fi.unibet.com/poker/guides/mit%C3%A4-pokerik%C3%A4si%C3%A4-minun-tulisi-pelata-ja-miksi-1.734306\",\"leadInText\":\"Et voi pelata jokaista pokerikättä voitokkaasti. Tämä on ikävä totuus sekä huvikseen, että ammatikseen pelaaville. Lauseet, kuten ”Tiedän, että maksoin löysästi, mutta veikkaan pystyväni voittamaan flopin jälkeen” tai ”Jos saan hyvän flopin, voin iskeä kunnolla kiinni” ovat puhdasta haihattelua.\",\"lead\":\"\\u003cp\\u003ePokerin säännöt ovat yksinkertaiset, ja pokerikäsien rankingit varsin selkeät. Sinulla voi olla 10 erilaista kättä. Arvokkain käsistä on kuningasvärisuora, ja heikoin hai.\\u003c/p\\u003e\\r\\n\\r\\n\\u003cp\\u003eJos etsit tietoa siitä, mitä käsiä kannattaa pelata ja mitä ei, tsekkaa oppaamme aloituskäsistä, josta löydät toisen lunttilapun.\\u003c/p\\u003e\\r\\n\",\"publishedDateTime\":1450777062000,\"image\":{\"name\":\"tile-hands-rankings\",\"contentId\":\"contentid/1.696152\",\"self\":\"/onecms/proxy/content/contentid/policy:1.696152\",\"contractInvalid\":false,\"contractType\":\"com.unibet.cms.contract.top.ImageContract\",\"containingKmfEnabledContent\":false,\"title\":\"tile-hands-rankings\",\"url\":\"https://fi.unibet.com/polopoly_fs/1.696152.1482141230!/image/1623528856.jpg\",\"imageLink\":\"/polopoly_fs/1.696152.1482141230!/image/1623528856.jpg\",\"contentIdString\":\"1.696152\",\"isReferenceContract\":false,\"appliedView\":\"teaser\",\"isVelocityEnabled\":true},\"categories\":{\"contractInvalid\":false,\"contractType\":\"com.unibet.cms.contract.top.MetadataContract\",\"entities\":[{\"name\":\"Poker\",\"id\":\"department.categorydimension.subject.poker\",\"dimensionName\":\"Subjects\",\"dimensionId\":\"department.categorydimension.subject\",\"url\":\"poker\"}]},\"amountOfLinks\":10000,\"theme\":\"no box\",\"isPersonalized\":false,\"contentIdString\":\"1.734306\",\"isReferenceContract\":false,\"appliedView\":\"teaser\",\"isVelocityEnabled\":true},{\"self\":\"/onecms/proxy/content/contentid/policy:1.790242\",\"contractInvalid\":false,\"contractType\":\"com.unibet.cms.contract.top.ArticleContract\",\"containingKmfEnabledContent\":false,\"name\":\"Mistä tiedän, millainen käsi vastustajallani on?\",\"url\":\"https://fi.unibet.com/poker/guides/mist%C3%A4-tied%C3%A4n-millainen-k%C3%A4si-vastustajallani-on-1.790242\",\"leadInText\":\"Vastustajan käden lukeminen on yksi pokerin vaikeimpia osa-alueita. Tämä pätee varsinkin nettipokerissa, jossa vastustajan fyysisestä olemuksesta ei voi tehdä päätelmiä. Kun kuitenkin hallitset tämän alueen pelistäsi, huomaat sen antamat hyödyt nopeasti.\",\"lead\":\"\\u003cp\\u003e\\u003cspan style\\u003d\\\"line-height: 20.8px;\\\"\\u003eVastustajan käden lukeminen on yksi pokerin vaikeimpia osa-alueita. Tämä pätee varsinkin nettipokerissa, jossa vastustajan fyysisestä olemuksesta ei voi tehdä päätelmiä. Kun kuitenkin hallitset tämän alueen pelistäsi, huomaat sen antamat hyödyt nopeasti.\\u003c/span\\u003e\\u003c/p\\u003e\\r\\n\",\"publishedDateTime\":1463738097000,\"image\":{\"name\":\"fp poker freeroll\",\"contentId\":\"contentid/1.686715\",\"self\":\"/onecms/proxy/content/contentid/policy:1.686715\",\"contractInvalid\":false,\"contractType\":\"com.unibet.cms.contract.top.ImageContract\",\"containingKmfEnabledContent\":false,\"title\":\"fp poker freeroll\",\"url\":\"https://fi.unibet.com/polopoly_fs/1.686715.1482141273!/image/2451712426.jpg\",\"imageLink\":\"/polopoly_fs/1.686715.1482141273!/image/2451712426.jpg\",\"contentIdString\":\"1.686715\",\"isReferenceContract\":false,\"appliedView\":\"teaser\",\"isVelocityEnabled\":true},\"categories\":{\"contractInvalid\":false,\"contractType\":\"com.unibet.cms.contract.top.MetadataContract\",\"entities\":[{\"name\":\"Poker\",\"id\":\"department.categorydimension.subject.poker\",\"dimensionName\":\"Subjects\",\"dimensionId\":\"department.categorydimension.subject\",\"url\":\"poker\"}]},\"amountOfLinks\":10000,\"theme\":\"no box\",\"isPersonalized\":false,\"contentIdString\":\"1.790242\",\"isReferenceContract\":false,\"appliedView\":\"teaser\",\"isVelocityEnabled\":true},{\"self\":\"/onecms/proxy/content/contentid/policy:1.790184\",\"contractInvalid\":false,\"contractType\":\"com.unibet.cms.contract.top.ArticleContract\",\"containingKmfEnabledContent\":false,\"name\":\"Kuinka pelata floppi PLO:ssa\",\"url\":\"https://fi.unibet.com/poker/guides/kuinka-pelata-floppi-plo-ssa-1.790184\",\"leadInText\":\"PLO:ssa menestymisen kannalta tärkeää on aggressiivinen pelaaminen. Flopissa paras tilanne on saada yksi hyvä käsi ja tämän lisäksi varakäsi, jota voit hakea tarpeen tullen. Tätä ei tapahdu niin usein, kuin ehkä haluaisi.\",\"publishedDateTime\":1463731704000,\"image\":{\"name\":\"Poker images 3\",\"contentId\":\"contentid/1.734994\",\"self\":\"/onecms/proxy/content/contentid/policy:1.734994\",\"contractInvalid\":false,\"contractType\":\"com.unibet.cms.contract.top.ImageContract\",\"containingKmfEnabledContent\":false,\"title\":\"Poker images 3\",\"url\":\"https://fi.unibet.com/polopoly_fs/1.734994.1482141103!/image/4201939506.png\",\"imageLink\":\"/polopoly_fs/1.734994.1482141103!/image/4201939506.png\",\"contentIdString\":\"1.734994\",\"isReferenceContract\":false,\"appliedView\":\"teaser\",\"isVelocityEnabled\":true},\"categories\":{\"contractInvalid\":false,\"contractType\":\"com.unibet.cms.contract.top.MetadataContract\",\"entities\":[{\"name\":\"Poker\",\"id\":\"department.categorydimension.subject.poker\",\"dimensionName\":\"Subjects\",\"dimensionId\":\"department.categorydimension.subject\",\"url\":\"poker\"}]},\"amountOfLinks\":10000,\"theme\":\"no box\",\"isPersonalized\":false,\"contentIdString\":\"1.790184\",\"isReferenceContract\":false,\"appliedView\":\"teaser\",\"isVelocityEnabled\":true},{\"self\":\"/onecms/proxy/content/contentid/policy:1.790182\",\"contractInvalid\":false,\"contractType\":\"com.unibet.cms.contract.top.ArticleContract\",\"containingKmfEnabledContent\":false,\"name\":\"Miksi jotkut pitävät nettipokerista enemmän kuin livepokerista?\",\"url\":\"https://fi.unibet.com/poker/guides/miksi-jotkut-pit%C3%A4v%C3%A4t-nettipokerista-enemm%C3%A4n-kuin-livepokerista-1.790182\",\"leadInText\":\"Nettipokeri on suositumpaa kuin koskaan. Pelaamalla pokeria netissä, voit nauttia pelin antamasta jännityksestä kotisohvaltasi. Käymme tässä artikkelissa syitä siihen, miksi jotkut ihmiset pitävät enemmän nettipokerista kuin livepokerista.\",\"publishedDateTime\":1463731504000,\"image\":{\"name\":\"Poker images 6\",\"contentId\":\"contentid/1.734997\",\"self\":\"/onecms/proxy/content/contentid/policy:1.734997\",\"contractInvalid\":false,\"contractType\":\"com.unibet.cms.contract.top.ImageContract\",\"containingKmfEnabledContent\":false,\"title\":\"Poker images 6\",\"url\":\"https://fi.unibet.com/polopoly_fs/1.734997.1482141103!/image/848563522.png\",\"imageLink\":\"/polopoly_fs/1.734997.1482141103!/image/848563522.png\",\"contentIdString\":\"1.734997\",\"isReferenceContract\":false,\"appliedView\":\"teaser\",\"isVelocityEnabled\":true},\"categories\":{\"contractInvalid\":false,\"contractType\":\"com.unibet.cms.contract.top.MetadataContract\",\"entities\":[{\"name\":\"Poker\",\"id\":\"department.categorydimension.subject.poker\",\"dimensionName\":\"Subjects\",\"dimensionId\":\"department.categorydimension.subject\",\"url\":\"poker\"}]},\"amountOfLinks\":10000,\"theme\":\"no box\",\"isPersonalized\":false,\"contentIdString\":\"1.790182\",\"isReferenceContract\":false,\"appliedView\":\"teaser\",\"isVelocityEnabled\":true},{\"self\":\"/onecms/proxy/content/contentid/policy:1.783189\",\"contractInvalid\":false,\"contractType\":\"com.unibet.cms.contract.top.ArticleContract\",\"containingKmfEnabledContent\":false,\"name\":\"Kuinka tulla ammattilaiseksi nettipokerissa?\",\"url\":\"https://fi.unibet.com/poker/guides/kuinka-tulla-ammattilaiseksi-nettipokerissa-1.783189\",\"leadInText\":\"Jos nettipokeri on sinulle vielä uusi peli, voi voittojen haaliminen tuntua vaikealta. Pokerin pelaaminen ammattina saattaa kuulostaa mahtavalta työltä, mutta siinä menestyminen vaatii runsaasti harjoittelua ja pelille omistautumista. Tästä artikkelista voit lukea, mitä sinun tulee tehdä, jotta nousisit pokerin superstaraksi.\",\"publishedDateTime\":1462264432000,\"image\":{\"name\":\"Poker images 5\",\"contentId\":\"contentid/1.734996\",\"self\":\"/onecms/proxy/content/contentid/policy:1.734996\",\"contractInvalid\":false,\"contractType\":\"com.unibet.cms.contract.top.ImageContract\",\"containingKmfEnabledContent\":false,\"title\":\"Poker images 5\",\"url\":\"https://fi.unibet.com/polopoly_fs/1.734996.1482141103!/image/1966372754.png\",\"imageLink\":\"/polopoly_fs/1.734996.1482141103!/image/1966372754.png\",\"contentIdString\":\"1.734996\",\"isReferenceContract\":false,\"appliedView\":\"teaser\",\"isVelocityEnabled\":true},\"categories\":{\"contractInvalid\":false,\"contractType\":\"com.unibet.cms.contract.top.MetadataContract\",\"entities\":[{\"name\":\"Poker\",\"id\":\"department.categorydimension.subject.poker\",\"dimensionName\":\"Subjects\",\"dimensionId\":\"department.categorydimension.subject\",\"url\":\"poker\"}]},\"amountOfLinks\":10000,\"theme\":\"no box\",\"isPersonalized\":false,\"contentIdString\":\"1.783189\",\"isReferenceContract\":false,\"appliedView\":\"teaser\",\"isVelocityEnabled\":true},{\"self\":\"/onecms/proxy/content/contentid/policy:1.782537\",\"contractInvalid\":false,\"contractType\":\"com.unibet.cms.contract.top.ArticleContract\",\"containingKmfEnabledContent\":false,\"name\":\"Opas pokerin pienten panosten käteispeleihin\",\"url\":\"https://fi.unibet.com/poker/guides/opas-pokerin-pienten-panosten-k%C3%A4teispeleihin-1.782537\",\"leadInText\":\"Lue oppaastamme ohjeet käsien lukemiseen, panostukseen ja voittojen kasvattamiseen pienten panosten käteispeleissä.\",\"publishedDateTime\":1461831153000,\"image\":{\"name\":\"Poker-tutorials-uo\",\"contentId\":\"contentid/1.686218\",\"self\":\"/onecms/proxy/content/contentid/policy:1.686218\",\"contractInvalid\":false,\"contractType\":\"com.unibet.cms.contract.top.ImageContract\",\"containingKmfEnabledContent\":false,\"title\":\"Poker-tutorials-uo\",\"url\":\"https://fi.unibet.com/polopoly_fs/1.686218.1482141274!/image/1657279729.jpg\",\"imageLink\":\"/polopoly_fs/1.686218.1482141274!/image/1657279729.jpg\",\"contentIdString\":\"1.686218\",\"isReferenceContract\":false,\"appliedView\":\"teaser\",\"isVelocityEnabled\":true},\"categories\":{\"contractInvalid\":false,\"contractType\":\"com.unibet.cms.contract.top.MetadataContract\",\"entities\":[{\"name\":\"Poker\",\"id\":\"department.categorydimension.subject.poker\",\"dimensionName\":\"Subjects\",\"dimensionId\":\"department.categorydimension.subject\",\"url\":\"poker\"}]},\"amountOfLinks\":10000,\"theme\":\"no box\",\"isPersonalized\":false,\"contentIdString\":\"1.782537\",\"isReferenceContract\":false,\"appliedView\":\"teaser\",\"isVelocityEnabled\":true},{\"self\":\"/onecms/proxy/content/contentid/policy:1.734343\",\"contractInvalid\":false,\"contractType\":\"com.unibet.cms.contract.top.ArticleContract\",\"containingKmfEnabledContent\":false,\"name\":\"Pokeripelien valitseminen\",\"url\":\"https://fi.unibet.com/poker/guides/pokeripelien-valitseminen-1.734343\",\"leadInText\":\"Pitkän työpäivän jälkeen on usein helpoin ratkaisu avata nettipokeri ja hypätä ensimmäiseen mahdolliseen pokerihuoneen peliin sammuttaakseen pelihimonsa. Onko tämä kuitenkaan välttämättä paras ratkaisu rahantekemisen ja pelistä nauttimisen kannalta?\",\"publishedDateTime\":1450785554000,\"image\":{\"name\":\"fp live holdem\",\"contentId\":\"contentid/1.684387\",\"self\":\"/onecms/proxy/content/contentid/policy:1.684387\",\"contractInvalid\":false,\"contractType\":\"com.unibet.cms.contract.top.ImageContract\",\"containingKmfEnabledContent\":false,\"title\":\"fp live holdem\",\"url\":\"https://fi.unibet.com/polopoly_fs/1.684387.1490359762!/lfpimage/283219084.jpg\",\"imageLink\":\"/polopoly_fs/1.684387.1490359762!/lfpimage/283219084.jpg\",\"contentIdString\":\"1.684387\",\"isReferenceContract\":false,\"appliedView\":\"teaser\",\"isVelocityEnabled\":true},\"categories\":{\"contractInvalid\":false,\"contractType\":\"com.unibet.cms.contract.top.MetadataContract\",\"entities\":[{\"name\":\"Poker\",\"id\":\"department.categorydimension.subject.poker\",\"dimensionName\":\"Subjects\",\"dimensionId\":\"department.categorydimension.subject\",\"url\":\"poker\"}]},\"amountOfLinks\":10000,\"theme\":\"no box\",\"isPersonalized\":false,\"contentIdString\":\"1.734343\",\"isReferenceContract\":false,\"appliedView\":\"teaser\",\"isVelocityEnabled\":true},{\"self\":\"/onecms/proxy/content/contentid/policy:1.777045\",\"contractInvalid\":false,\"contractType\":\"com.unibet.cms.contract.top.ArticleContract\",\"containingKmfEnabledContent\":false,\"name\":\"Henkisen vahvuuden merkitys nettipokerissa\",\"url\":\"https://fi.unibet.com/poker/guides/henkisen-vahvuuden-merkitys-nettipokerissa-1.777045\",\"leadInText\":\"Oletko koskaan miettinyt, miksi pelaat nettipokeria loistavasti yhtenä päivänä ja surkeasti seuraavana? Monet pokerinpelaajat tuntevat pelaamisen olevan yhtä vuoristorataa, jolloin pelaaja tippuu huipulta pohjalle lyhyessä ajassa.\",\"publishedDateTime\":1460026467000,\"image\":{\"name\":\"Poker images 8\",\"contentId\":\"contentid/1.734999\",\"self\":\"/onecms/proxy/content/contentid/policy:1.734999\",\"contractInvalid\":false,\"contractType\":\"com.unibet.cms.contract.top.ImageContract\",\"containingKmfEnabledContent\":false,\"title\":\"Poker images 8\",\"url\":\"https://fi.unibet.com/polopoly_fs/1.734999.1482141103!/image/2376381219.png\",\"imageLink\":\"/polopoly_fs/1.734999.1482141103!/image/2376381219.png\",\"contentIdString\":\"1.734999\",\"isReferenceContract\":false,\"appliedView\":\"teaser\",\"isVelocityEnabled\":true},\"categories\":{\"contractInvalid\":false,\"contractType\":\"com.unibet.cms.contract.top.MetadataContract\",\"entities\":[{\"name\":\"Poker\",\"id\":\"department.categorydimension.subject.poker\",\"dimensionName\":\"Subjects\",\"dimensionId\":\"department.categorydimension.subject\",\"url\":\"poker\"}]},\"amountOfLinks\":10000,\"theme\":\"no box\",\"isPersonalized\":false,\"contentIdString\":\"1.777045\",\"isReferenceContract\":false,\"appliedView\":\"teaser\",\"isVelocityEnabled\":true},{\"self\":\"/onecms/proxy/content/contentid/policy:1.771713\",\"contractInvalid\":false,\"contractType\":\"com.unibet.cms.contract.top.ArticleContract\",\"containingKmfEnabledContent\":false,\"name\":\"Floattaaminen nettipokerissa\",\"url\":\"https://fi.unibet.com/poker/guides/floattaaminen-nettipokerissa-1.771713\",\"leadInText\":\"Floattaaminen on termi, joka on ilmestynyt viime aikoina nettipokerin ja Texas Hold\\u0027emin maailmaan. Floattaamisella tarkoitetaan sitä, kun pelaaja maksaa vastustajan panostuksen olemattomalla kädellä. Tarkoituksena on bluffata potti pelin myöhemmässä vaiheessa.\",\"publishedDateTime\":1459350070000,\"image\":{\"name\":\"tile unibet open hand of the week\",\"contentId\":\"contentid/1.760543\",\"self\":\"/onecms/proxy/content/contentid/policy:1.760543\",\"contractInvalid\":false,\"contractType\":\"com.unibet.cms.contract.top.ImageContract\",\"containingKmfEnabledContent\":false,\"title\":\"tile unibet open hand of the week\",\"url\":\"https://fi.unibet.com/polopoly_fs/1.760543.1482140996!/image/3519022320.png\",\"imageLink\":\"/polopoly_fs/1.760543.1482140996!/image/3519022320.png\",\"contentIdString\":\"1.760543\",\"isReferenceContract\":false,\"appliedView\":\"teaser\",\"isVelocityEnabled\":true},\"categories\":{\"contractInvalid\":false,\"contractType\":\"com.unibet.cms.contract.top.MetadataContract\",\"entities\":[{\"name\":\"Poker\",\"id\":\"department.categorydimension.subject.poker\",\"dimensionName\":\"Subjects\",\"dimensionId\":\"department.categorydimension.subject\",\"url\":\"poker\"}]},\"amountOfLinks\":10000,\"theme\":\"no box\",\"isPersonalized\":false,\"contentIdString\":\"1.771713\",\"isReferenceContract\":false,\"appliedView\":\"teaser\",\"isVelocityEnabled\":true},{\"self\":\"/onecms/proxy/content/contentid/policy:1.758045\",\"contractInvalid\":false,\"contractType\":\"com.unibet.cms.contract.top.ArticleContract\",\"containingKmfEnabledContent\":false,\"name\":\"Pelin lukeminen nettipokerissa\",\"url\":\"https://fi.unibet.com/poker/guides/pelin-lukeminen-nettipokerissa-1.758045\",\"leadInText\":\"Hyvän pelaajan tunnistaa siitä, että hän joutuu tekemään usein vaikeita päätöksiä ja nämä päätökset ovat useimmiten oikeita.\",\"publishedDateTime\":1458638292000,\"image\":{\"name\":\"Poker images 10\",\"contentId\":\"contentid/1.735001\",\"self\":\"/onecms/proxy/content/contentid/policy:1.735001\",\"contractInvalid\":false,\"contractType\":\"com.unibet.cms.contract.top.ImageContract\",\"containingKmfEnabledContent\":false,\"title\":\"Poker images 10\",\"url\":\"https://fi.unibet.com/polopoly_fs/1.