            "text": "{\"id\":\"policy:2.292315\",\"version\":\"policy:2.292315:1742474303\",\"meta\":{\"modificationTime\":\"1742474354000\",\"originalCreationTime\":\"1742474123000\"},\"aspects\":{\"contentData\":{\"data\":{\"contentId\":\"contentid/2.292315\",\"self\":\"/onecms/proxy/content/contentid/policy:2.292315\",\"contractInvalid\":false,\"contractType\":\"com.unibet.cms.contract.top.context.page.PageContract\",\"containingKmfEnabledContent\":false,\"linkLabel\":\"Casino Guides\",\"metadata\":{\"contentId\":\"contentid/2.292315\",\"self\":\"/onecms/proxy/content/contentid/policy:2.292315\",\"contractInvalid\":false,\"contractType\":\"com.unibet.cms.contract.top.context.site.PageMetaDataContract\",\"containingKmfEnabledContent\":false,\"teaserText\":\"\",\"teaserTextLength\":100000,\"metaTags\":[],\"linkTags\":[],\"canonicalUrl\":\"\",\"contentIdString\":\"2.292315\",\"isReferenceContract\":false,\"isVelocityEnabled\":true},\"slots\":{\"topRightSlot\":{\"elements\":[],\"name\":\"pageLayout/selected/topRightSlot\",\"contentIdString\":\"2.292315\",\"contentId\":\"contentid/2.292315\",\"self\":\"/onecms/proxy/content/contentid/policy:2.292315\",\"input\":[],\"contractInvalid\":false,\"contractType\":\"com.unibet.cms.contract.top.contentapi.SlotContract\",\"containingKmfEnabledContent\":false,\"inherit\":true,\"containsKMFEnabledElement\":false,\"isReferenceContract\":false,\"isVelocityEnabled\":true},\"middleRightSlot\":{\"elements\":[],\"name\":\"pageLayout/selected/middleRightSlot\",\"contentIdString\":\"2.292315\",\"contentId\":\"contentid/2.292315\",\"self\":\"/onecms/proxy/content/contentid/policy:2.292315\",\"input\":[],\"contractInvalid\":false,\"contractType\":\"com.unibet.cms.contract.top.contentapi.SlotContract\",\"containingKmfEnabledContent\":false,\"inherit\":true,\"containsKMFEnabledElement\":false,\"isReferenceContract\":false,\"isVelocityEnabled\":true},\"takeoverSlot\":{\"elements\":[],\"name\":\"pageLayout/selected/takeoverSlot\",\"contentIdString\":\"2.292315\",\"contentId\":\"contentid/2.292315\",\"self\":\"/onecms/proxy/content/contentid/policy:2.292315\",\"input\":[],\"contractInvalid\":false,\"contractType\":\"com.unibet.cms.contract.top.contentapi.SlotContract\",\"containingKmfEnabledContent\":false,\"inherit\":false,\"containsKMFEnabledElement\":false,\"isReferenceContract\":false,\"isVelocityEnabled\":true},\"mainSlot\":{\"elements\":[{\"contentId\":\"contentid/7.963992\",\"self\":\"/onecms/proxy/content/contentid/policy:7.963992\",\"input\":[\"offset\",\"limit\"],\"contractInvalid\":false,\"contractType\":\"com.unibet.cms.contract.top.socialhub.ListElementContract\",\"containingKmfEnabledContent\":false,\"name\":\"Beginner Guides\",\"heading\":\"Vedonlyönti laji lajilta\",\"elements\":[{\"self\":\"/onecms/proxy/content/contentid/policy:1.2284865\",\"contractInvalid\":false,\"contractType\":\"com.unibet.cms.contract.top.ArticleContract\",\"containingKmfEnabledContent\":false,\"name\":\"Vedonlyöntiopas vuoden 2023 Euroviisuihin\",\"url\":\"https://fi.unibet.com/betting/guides/vedonly%C3%B6ntiopas-vuoden-2023-euroviisuihin-1.2284865\",\"leadInText\":\"Eurovision laulukilpailu, eli Euroviisut, on vuoden ehdoton kohokohta monille. Jo kuukausia ennen kilpailuja alkaa spekulointi eri maiden edustajista ja tietenkin varsinaisissa Euroviisuissa menestyvistä maista.\",\"publishedDateTime\":1681823142000,\"image\":{\"name\":\"Eurovision2.jpg\",\"contentId\":\"contentid/1.1185280\",\"self\":\"/onecms/proxy/content/contentid/policy:1.1185280\",\"contractInvalid\":false,\"contractType\":\"com.unibet.cms.contract.top.ImageContract\",\"containingKmfEnabledContent\":false,\"title\":\"Eurovision2.jpg\",\"url\":\"https://fi.unibet.com/polopoly_fs/1.1185280.1636490388!/image/2420600883.jpg\",\"imageLink\":\"/polopoly_fs/1.1185280.1636490388!/image/2420600883.jpg\",\"contentIdString\":\"1.1185280\",\"isReferenceContract\":false,\"appliedView\":\"teaser\",\"isVelocityEnabled\":true},\"categories\":{\"contractInvalid\":false,\"contractType\":\"com.unibet.cms.contract.top.MetadataContract\",\"entities\":[]},\"amountOfLinks\":10000,\"theme\":\"no box\",\"isPersonalized\":false,\"contentIdString\":\"1.2284865\",\"isReferenceContract\":false,\"appliedView\":\"teaser\",\"isVelocityEnabled\":true},{\"self\":\"/onecms/proxy/content/contentid/policy:1.2153830\",\"contractInvalid\":false,\"contractType\":\"com.unibet.cms.contract.top.ArticleContract\",\"containingKmfEnabledContent\":false,\"name\":\"Opas MM-kisojen 2022 vedonlyöntiin\",\"url\":\"https://fi.unibet.com/betting/guides/opas-mm-kisojen-2022-vedonly%C3%B6ntiin-1.2153830\",\"leadInText\":\"Unibetilla voit lyödä vetoa jokaisesta jalkapallon MM-kisojen ottelusta sekä ennakkoon että ottelun aikana. Valtava vedonlyöntikohteiden valikoima on tarjolla ennen jokaista peliä, samoin kuin voittajavedot, joiden kautta voit lyödä vetoa turnauksen voittajasta.\",\"publishedDateTime\":1666338078000,\"image\":{\"name\":\"Football.jpg\",\"contentId\":\"contentid/1.1263591\",\"self\":\"/onecms/proxy/content/contentid/policy:1.1263591\",\"contractInvalid\":false,\"contractType\":\"com.unibet.cms.contract.top.ImageContract\",\"containingKmfEnabledContent\":false,\"title\":\"Football.jpg\",\"url\":\"https://fi.unibet.com/polopoly_fs/1.1263591.1636525578!/image/2411451817.jpg\",\"imageLink\":\"/polopoly_fs/1.1263591.1636525578!/image/2411451817.jpg\",\"contentIdString\":\"1.1263591\",\"isReferenceContract\":false,\"appliedView\":\"teaser\",\"isVelocityEnabled\":true},\"categories\":{\"contractInvalid\":false,\"contractType\":\"com.unibet.cms.contract.top.MetadataContract\",\"entities\":[]},\"amountOfLinks\":10000,\"theme\":\"no box\",\"isPersonalized\":false,\"contentIdString\":\"1.2153830\",\"isReferenceContract\":false,\"appliedView\":\"teaser\",\"isVelocityEnabled\":true},{\"self\":\"/onecms/proxy/content/contentid/policy:1.1601486\",\"contractInvalid\":false,\"contractType\":\"com.unibet.cms.contract.top.ArticleContract\",\"containingKmfEnabledContent\":false,\"name\":\"Vedonlyönti politiikasta – Unibetin opas politiikan vedonlyöntiin\",\"url\":\"https://fi.unibet.com/betting/guides/usa-n-presidentinvaalit-opas-vedonlyontiin-1.1601486\",\"leadInText\":\"Politiikan vedonlyöntikohteet ovat luonnollisestikin vaihtuvaa sorttia, sillä vaaleja käydään vain tiettyinä, ennalta määriteltyinä aikoina. Eri maiden vaalit ja äänestykset ajoittuvat kuitenkin melko eri aikoihin ja eri vuosille, joten Unibetilta löytyy lähestulkoon jatkuvasti jonkin sortin vetokohteita politiikan saralla.\",\"publishedDateTime\":1602167809000,\"image\":{\"name\":\"US_Election_hero_mobile\",\"contentId\":\"contentid/1.1587697\",\"self\":\"/onecms/proxy/content/contentid/policy:1.1587697\",\"contractInvalid\":false,\"contractType\":\"com.unibet.cms.contract.top.ImageContract\",\"containingKmfEnabledContent\":false,\"title\":\"US_Election_hero_mobile\",\"url\":\"https://fi.unibet.com/polopoly_fs/1.1587697.1636546497!/image/3752484583.jpg\",\"imageLink\":\"/polopoly_fs/1.1587697.1636546497!/image/3752484583.jpg\",\"contentIdString\":\"1.1587697\",\"isReferenceContract\":false,\"appliedView\":\"teaser\",\"isVelocityEnabled\":true},\"categories\":{\"contractInvalid\":false,\"contractType\":\"com.unibet.cms.contract.top.MetadataContract\",\"entities\":[{\"name\":\"Other\",\"id\":\"department.categorydimension.subject.other\",\"dimensionName\":\"Subjects\",\"dimensionId\":\"department.categorydimension.subject\",\"url\":\"other\"}]},\"amountOfLinks\":10000,\"theme\":\"no box\",\"isPersonalized\":false,\"contentIdString\":\"1.1601486\",\"isReferenceContract\":false,\"appliedView\":\"teaser\",\"isVelocityEnabled\":true},{\"self\":\"/onecms/proxy/content/contentid/policy:1.1222695\",\"contractInvalid\":false,\"contractType\":\"com.unibet.cms.contract.top.ArticleContract\",\"containingKmfEnabledContent\":false,\"name\":\"Kuinka lyödä vetoa tenniksestä – säännöt ja parhaat vinkit \",\"url\":\"https://fi.unibet.com/betting/guides/kuinka-ly%C3%B6d%C3%A4-vetoa-tenniksest%C3%A4-s%C3%A4%C3%A4nn%C3%B6t-ja-parhaat-vinkit-1.1222695\",\"leadInText\":\"Miljoonat silmäparit seuraavat tennisotteluita vuosittain. Tutustu tenniksen vedonlyönnin saloihin ja laita oma vetosi sisään!\",\"publishedDateTime\":1564053607000,\"image\":{\"name\":\"NADAL-tennis-Roma.jpg\",\"contentId\":\"contentid/1.1177158\",\"self\":\"/onecms/proxy/content/contentid/policy:1.1177158\",\"contractInvalid\":false,\"contractType\":\"com.unibet.cms.contract.top.ImageContract\",\"containingKmfEnabledContent\":false,\"title\":\"NADAL-tennis-Roma.jpg\",\"url\":\"https://fi.unibet.com/polopoly_fs/1.1177158.1636490147!/image/1724996041.jpg\",\"imageLink\":\"/polopoly_fs/1.1177158.1636490147!/image/1724996041.jpg\",\"contentIdString\":\"1.1177158\",\"isReferenceContract\":false,\"appliedView\":\"teaser\",\"isVelocityEnabled\":true},\"categories\":{\"contractInvalid\":false,\"contractType\":\"com.unibet.cms.contract.top.MetadataContract\",\"entities\":[{\"name\":\"Sports\",\"id\":\"department.categorydimension.subject.sports\",\"dimensionName\":\"Subjects\",\"dimensionId\":\"department.categorydimension.subject\",\"url\":\"sports\"},{\"name\":\"Tennis\",\"id\":\"department.categorydimension.subject.sports.tennis\",\"dimensionName\":\"Subjects\",\"dimensionId\":\"department.categorydimension.subject\",\"url\":\"tennis\"}]},\"amountOfLinks\":10000,\"theme\":\"no box\",\"isPersonalized\":false,\"contentIdString\":\"1.1222695\",\"isReferenceContract\":false,\"appliedView\":\"teaser\",\"isVelocityEnabled\":true},{\"self\":\"/onecms/proxy/content/contentid/policy:1.1221440\",\"contractInvalid\":false,\"contractType\":\"com.unibet.cms.contract.top.ArticleContract\",\"containingKmfEnabledContent\":false,\"name\":\"Golf-vedonlyöntiopas – säännöt ja parhaat betsausvinkit\",\"url\":\"https://fi.unibet.com/betting/guides/golf-vedonly%C3%B6ntiopas-s%C3%A4%C3%A4nn%C3%B6t-ja-parhaat-betsausvinkit-1.1221440\",\"leadInText\":\"Golf on viihdyttävä taitolaji, joka kiehtoo vedonl