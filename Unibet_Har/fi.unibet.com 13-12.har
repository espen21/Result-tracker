.\\n{c2}UPDATE?\",\n            \"version_update_config_error\": \"Error in the update configuration file\",\n            \"version_update_corrupt\": \"Corrupted file. Retry download?\",\n            \"version_update_failed\": \"Update file is incorrect, please contact technical support if the problem persist. Restart application?\"\n        }\n    },\n    \"tabControl\": {\n        \"tip\": {\n            \"instructionToUse\": \"Hold to start moving\"\n        }\n    },\n    \"table\": {\n        \"banzai20\": {\n            \"queueInfoText\": \"In Banzai, you will be assigned a random alias. Your journey starts from white belt and you can progress to black belt.\"\n        },\n        \"buttons\": {\n            \"allin\": \"All-in\",\n            \"bet\": \"Bet\",\n            \"call\": \"Call\",\n            \"check\": \"Check\",\n            \"fold\": \"Fold\",\n            \"foldToAnyBet\": \"Fold to any bet\",\n            \"foldToAnyBetPhone\": \"Fold\\nto any bet\",\n            \"play\": \"Play\",\n            \"quickBet\": {\n                \"2x\": \"2x\",\n                \"3x\": \"3x\",\n                \"4x\": \"4x\",\n                \"allIn\": \"All-in\",\n                \"half\": \"1/2 Pot\",\n                \"pot\": \"Pot\",\n                \"quarter\": \"1/4 Pot\",\n                \"threeQuarters\": \"3/4 Pot\"\n            },\n            \"raise\": \"Raise\",\n            \"waitForBB\": \"WAIT FOR BIG BLIND\",\n            \"waitForBBPhone\": \"WAIT\\nFOR BIG BLIND\"\n        },\n        \"buyin\": {\n            \"autoTopUpInfo\": \"If auto top up is enabled, your stack will be topped up to the initial buy-in after every hand\",\n            \"balance\": \"Balance:\",\n            \"buttons\": {\n                \"addon\": \"Add-On\",\n                \"buy\": \"Buy\",\n                \"buyIn\": \"Buy-in\",\n                \"cash\": \"Cash\",\n                \"deposit\": \"Deposit\",\n                \"max\": \"Max:\",\n                