      \"unregister\": \"Unregister\"\n    },\n    \"unibet\": {\n        \"login\": {\n            \"error\": {\n                \"10\": \"Blocked due to failed logins\",\n                \"11\": \"Blocked due to self exclusion\",\n                \"12\": \"Blocked by regulator\",\n                \"13\": \"Invalid device type\",\n                \"14\": \"Your account has been blocked\",\n                \"15\": \"You need to be 21 or over to play Unibet Poker\",\n                \"16\": \"Blocked by regulator due to invalid login type\",\n                \"17\": \"Blocked due to self exclusion. Customer needs to complete the positive action.\",\n                \"18\": \"Blocked due to self exclusion. Customer is in cooling off period.\",\n                \"3\": \"The login method is not allowed\",\n                \"4\": \"Your jurisdiction is not supported\",\n                \"5\": \"Customer's brand is not supported\"\n            }\n        }\n    },\n    \"unibet20anniversary\": {\n        \"earnedTickets\": \"Earned tickets: {0} (max is 20)\"\n    },\n    \"units\": {\n        \"d\": \"d\",\n        \"day\": \"Day\",\n        \"days\": \"Days\",\n        \"h\": \"h\",\n        \"hour\": \"Hour\",\n        \"hours\": \"Hours\",\n        \"m\": \"m\",\n        \"minute\": \"Minute\",\n        \"minutes\": \"Minutes\",\n        \"minutesShorter\": \"min\",\n        \"s\": \"s\",\n        \"second\": \"Second\",\n        \"seconds\": \"Seconds\"\n    },\n    \"virtualCelebrateTeamMTT\": {\n        \"promotionView\": {\n            \"buyinsDescription\": \"\",\n            \"qualifiersDescription\": \"\"\n        }\n    },\n    \"virtualHighrollerNights\": {\n        \"promotionView\": {\n            \"promoInfoText\": \"April 6 & 7\",\n            \"promoInfoTextNonMonetary\": \"April 6 & 7\"\n        }\n    },\n    \"virtualMTTCelebrateTeam\": {\n        \"promotionView\": {\n            \"promoInfoText\": \"After each day your country plays you can find a \\\"Celebrate your country\\\" tournament exclusive for your country! If your team reaches the knockout stage, we'll double the tournament guarantee - twice the support for your team's journey to victory!\",\n            \"promoInfoTextNonMonetary\": \"After each day your country plays you can find a \\\"Celebrate your country\\\" tournament exclusive for your country! If your team reaches the knockout stage, we'll double the tournament guarantee - twice the support for your team's journey to victory!\"\n        }\n    },\n    \"virtualMTTPokerSM\": {\n        \"promotionView\": {\n            \"promoInfoText\": \"Play Live Poker Championship in Bratislava this August!\\nHuge value with guaranteed live packages to win!\"\n        }\n    },\n    \"virtualMTTPredictor\": {\n        \"promotionView\": {\n            \"promoInfoText\": \"Win your share of \\u20ac5,000! Qualify for a \\u20ac4,000 or \\u20ac1,000 freeroll by predicting the winning country (= joining the flip MTT of the eventual winner) of the European Football Championship\"\n        }\n    },\n    \"virtualPhasedMTT\": {\n        \"promotionView\": {\n            \"buttonLabel\": {\n                \"goToTournament\": \"GO TO TOURNAMENT\",\n                \"phase1List\": \"PHASE 1 LIST\"\n            },\n            \"phase1ListHeader\": \"Upcoming Phase 1s:\",\n            \"phase1Period\": \"Phase 1: {0} - {1}\",\n            \"phase2Start\": \"Phase 2: {0}\",\n            \"prizepoolLabel\": \"PRIZEPOOL\",\n            \"promoInfoText\": \"Play \\u20ac5 buy-in Phase 1 to qualify to \\u20ac10,000 Phase 2\",\n            \"qualifiersStartingFrom\": \"Qualifiers starting from \\u20ac0.1\",\n            \"totalPhase1\": \"Phase 1s running daily\"\n        }\n    },\n    \"virtualPokerSMMTT\": {\n        \"promotionView\": {\n            \"buyinsDescription\": \"\",\n            \"qualifiersDescription\": \"\"\n        }\n    },\n    \"virtualPredictorMTT\": {\n        \"promotionView\": {\n            \"buyinsDescription\": \"Each freeroll flip runs with \\u20ac100 prizepool!\",\n            \"qualifiersDescription\": \"\"\n        }\n    },\n    \"virtualSeriesMTT\": {\n        \"promotionView\": {\n            \"buttonLabel\": {\n                \"viewLeaderboards\": \"\",\n                \"viewTournaments\": \"VIEW TOURNAMENTS\"\n            },\n            \"buyinsDescription\": \"Buy-ins \\u20ac1 - \\u20ac150\",\n            \"leaderboardsDescription\": \"2 leaderboards, total value \\u20ac7,300\",\n            \"leaderboardsOptIn\": \"To participate in Leaderboards please opt-in on the Leaderboards page\",\n            \"promoInfoText\": \"125 different tournaments, \\u20ac30,000 Main Event, \\u20ac7,300 Leaderboards\",\n            \"promoInfoTextNonMonetary\": \"More than 90 tournaments with a \\u20ac40,000 main event\",\n            \"qualifiersDescription\": \"Qualifiers starting from \\u20ac0.1\"\n        }\n    },\n    \"wcTeamCollector\": {\n        \"label\": {\n            \"showfullview\": \"ALL TEAMS\"\n        },\n        \"text\": {\n            \"expiresinfo\": \"Mission expires on {0}, at which point teams from {1} will be available to unlock.\",\n            \"headerprefix\": \"TEAM COLLECTOR: \",\n            \"prize\": \"Unlock one team to receive \\u20ac200 Daily Flip ticket.\\nUnlock all four teams to receive {0}\"\n        }\n    },\n    \"welcome\": {\n        \"header\": \"Welcome to {Brand}\",\n        \"text\": \"Complete new player missions for real money rewards\"\n    },\n    \"welcomeScreen\": {\n        \"page\": {\n            \"dailySpecials\": {\n                \"buttonJoin\": \"JOIN\",\n                \"buttonWeeklyMenu\": \"WEEKLY MENU\",\n                \"descriptionEvent1\": \"Can you collect all the chips and become our Pot Limit Omaha Shortstack Master? From {2}, take your seat with 10-20 big blinds and try to build the biggest stack you can.\\n\\nIf you\\u2019ve built the biggest stack by the end of the day, you\\u2019ll receive a \\u20ac50 cash game ticket for being the Shortstack Master! You\\u2019ll also earn an exclusive avatar and your alias will appear in the title the next week, so everyone will know you\\u2019re the one to beat!\",\n                \"descriptionEvent10\": \"Suit up and strap in for the Tuesday Take-off! Send your bankroll into orbit as you battle it out in our Hexapro Extreme games with buy-ins of \\u20ac1 and \\u20ac2. Our Extreme games blast off at lightning speeds and are action packed from start to finish.\\nWith jackpot games guaranteed every hour, you\\u2019re always just an orbit away from a prizepool that\\u2019s out of this world. \\n\\u20ac1 and \\u20ac2 buy-ins are available from {2} every Tuesday.\",\n                \"descriptionEvent11\": \"Hexapro Extreme goes out of this world with the Saturday Stratosphere. Big buy-ins and bigger prizes await as we blast off with high stakes action every Saturday.\\nJackpot games are guaranteed every other hour so you\\u2019re never far away from a meteoric prizepool.\\n\\u20ac10 and \\u20ac20 buy-ins are available from {2} every Saturday.\",\n                \"descriptionEvent12\": \"Think you\\u2019ve mastered HexaPro Extreme? It\\u2019s time to turn up the heat with HexaPLO Extreme \\u2013 where the high-speed action of Extreme meets the thrilling strategy of Pot-Limit Omaha. \\n\\nWith \\u20ac2 buy-ins and jackpots up to \\u20ac2000, HexaPLO Extreme gives you more chances to hit it big \\u2013 fast. Thanks to our boosted odds for the top prize, you\\u2019re just minutes away from a massive win.\",\n                \"descriptionEvent13\": \"With Flight Day, you can have big guarantees for a small buy-in. Phase 1\\u00b4s will be availble all day long and Phase 2 will be at 21h.\",\n                \"descriptionEvent14\": \"Forget the grind \\u2013 Wednesday Flipclusive is your express route to the money. Enter flips from as little as \\u20ac2, win your seat, and qualify for the Final where all players cash.\\n \\nOne day. One final. One shot at \\u20ac10K prizepool.\",\n                \"descriptionEvent2\": \"We\\u2019ve ramped up the pace with the Bubble Burster MTTs so you can reach the money even quicker! The tournaments start from 19:00 CET/CEST with buy-ins of \\u20ac1, \\u20ac5, and \\u20ac10 so everyone can get involved. Once you\\u2019re in the money, the tournaments will slow down so you have more time to manoeuvre your way to a big prize.\\nIf you win two Bubble Burster MTTs, at the same buy-in, in one night, then you\\u2019ll receive 100x the buy-in in bonus points and an exclusive avatar in recognition of you cleaning up at the tables.\\nFinish 1st in all three Bubble Burster MTTs at the same buy-in, in one night, and you\\u2019ll win 1000x the buy-in in cash. That\\u2019s \\u20ac1,000, \\u20ac5,000 or even \\u20ac10,000!\\n\",\n                \"descriptionEvent3\": \"Wednesday nights are getting wild as we unleash \\u20ac1/\\u20ac2 rebuy tournaments from 20:00 CET/CEST where the rebuys cost just \\u00bc of the buy-in. This means it\\u2019s even easier for you to get back into the jungle and chop down the competition.\\n\\nIf you win 2 Wild Wednesday MTTs, at the same stake, in 1 night, you\\u2019ll receive a special avatar so you can show everyone you\\u2019re top of the food chain.\",\n                \"descriptionEvent4\": \"Every Thursday from {0}, you have the chance to become a Deepstack Legend! We\\u2019ll be opening some special \\u20ac0.05/\\u20ac0.10 tables where you can sit down with 500-1000 big blinds and try to build the biggest stack you can before {1}.\\n\\nIf your stack towers over everyone else\\u2019s by the end of the night you\\u2019ll receive an exclusive avatar, the tables will be named after your alias the following week and a cash game ticket worth \\u20ac100!\",\n                \"descriptionEvent5\": \"Friday night is fight night as No limit Texas Hold\\u2019em cash games go Banzai! All players start with 10 big blinds and then war commences.\\n\\nFrom {2} we\\u2019ll also add a NL50 stake so everyone will have a chance to battle it out for supremacy on the felt. \\n\\nDuring the 11 hours of Banzai Bonanza you can earn points towards a \\u20ac250 flop race leaderboard with \\u20ac100 for the winner.\",\n                \"descriptionEvent6\": \"This is a poker game unlike anything you\\u2019ve ever seen before - HexaPro Extreme is faster and more adrenaline-filled with Jackpots hitting left and right. We\\u2019ve boosted the 100x multiplier to 125x and it hits 40 times more often than in regular HexaPro. As if that wasn\\u2019t enough, we\\u2019ll be running Jackpot Mania non-stop, and you\\u2019ll often find that a 125x game is guaranteed to hit within just a couple hundred games!\\n\\nThe lowest multiplier games are over in the blink of an eye while we allow for a proper game of poker when you get into the exciting 125x games. \\u20ac1 and \\u20ac10 buy-ins will be available from {0} every Saturday.\",\n                \"descriptionEvent7\": \"It\\u2019s time to blast off the biggest tournaments we have to offer, only on Stellar Sunday! The \\u20ac100 buy-in Supernova offers you a chance to send your bankroll to the moon each week and on the first Sunday of the month we also have the Supermoon. This \\u20ac250 buy-in PKO always offers an astronomical first place prize.\\n\\nLook out for the superqualifers running as well, so you can shoot for the stars on a budget.\",\n                \"descriptionEvent8\": \"Do you have what it takes to become the next French Poker Cup champion? You can buy-in directly or qualify via the satellites. The super satellite with 30 seats guaranteed starts every sunday at 18:00 CET/CEST\",\n                \"descriptionEvent9\": \"Friday night is fight night as No limit Texas Hold\\u2019em cash games go Banzai! All players start with 10 big blinds and then war commences.\\n\\nFrom {2} we\\u2019ll also add a NL50 stake so everyone will have a chance to battle it out for supremacy on the felt. \\n\\nDuring the 11 hours of Banzai Bonanza you can earn points towards a \\u20ac250 flop race leaderboard with \\u20ac100 for the winner.\",\n                \"descriptionEventNonMonetary1\": \"Can you collect all the chips and become our Pot Limit Omaha Shortstack Master? From {2}, take your seat with 10-20 big blinds and try to build the biggest stack you can. If you\\u2019ve built the biggest stack by the end of the day, you\\u2019ll receive an exclusive avatar and your alias will appear in the title the next week, so everyone will know you\\u2019re the one to beat!\",\n                \"descriptionEventNonMonetary10\": \"Suit up and strap in for the Tuesday Take-off! Send your bankroll into orbit as you battle it out in our Hexapro Extreme games with buy-ins of \\u20ac1 and \\u20ac2. Our Extreme games blast off at lightning speeds and are action packed from start to finish. \\u20ac1 and \\u20ac2 buy-ins are available from {2} every Tuesday.\",\n                \"descriptionEventNonMonetary11\": \"Hexapro Extreme goes out of this world with the Stratospheric Saturday. Big buy-ins and bigger prizes await as we blast off with high stakes action every Saturday.\\nWith Jackpot games happening more often, you\\u2019re never far away from a meteoric prizepool.\\n\\u20ac10 and \\u20ac20 buy-ins are available from {2} every Saturday.\",\n                \"descriptionEventNonMonetary12\": \"Think you\\u2019ve mastered HexaPro Extreme? It\\u2019s time to turn up the heat with HexaPLO Extreme \\u2013 where the high-speed action of Extreme meets the thrilling strategy of Pot-Limit Omaha. \\n\\nWith \\u20ac2 buy-ins and jackpots up to \\u20ac2000, HexaPLO Extreme gives you more chances to hit it big \\u2013 fast. Thanks to our boosted odds for the top prize, you\\u2019re just minutes away from a massive win.\",\n                \"descriptionEventNonMonetary14\": \"Forget the grind \\u2013 Wednesday Flipclusive is your express route to the money. Enter flips from as little as \\u20ac2, win your seat, and qualify for the Final where all players cash.\\n \\nOne day. One final. One shot at \\u20ac10K prizepool.\",\n                \"descriptionEventNonMonetary2\": \"We\\u2019ve ramped up the pace with the Bubble Burster MTTs so you can reach the money even quicker! The tournaments start from 19:00 CET/CEST with buy-ins of \\u20ac1, \\u20ac5, and \\u20ac10 so everyone can get involved. Once you\\u2019re in the money, the tournaments will slow down\",\n                \"descriptionEventNonMonetary3\": \"Wednesday nights are getting wild as we unleash \\u20ac1/\\u20ac2 rebuy tournaments from 20:00 CET/CEST where the rebuys cost just \\u00bc of the buy-in. This means it\\u2019s even easier for you to get back into the jungle and chop down the competition. If you win 2 Wild Wednesday MTTs, at the same stake, in 1 night, you\\u2019ll receive a special avatar so you can show everyone you\\u2019re top of the food chain.\",\n                \"descriptionEventNonMonetary4\": \"Every Thursday from {0}, you have the chance to become a Deepstack Legend! We\\u2019ll be opening some special \\u20ac0.05/\\u20ac0.10 tables where you can sit down with 500-1000 big blinds and try to build the biggest stack you can before {1}. If your stack towers over everyone else\\u2019s by the end of the night you\\u2019ll receive an exclusive avatar and the tables will be named after your alias the following week.\",\n                \"descriptionEventNonMonetary5\": \"Friday night is fight night as No limit Texas Hold\\u2019em cash games go Banzai! All players start with 10 big blinds and then war commences. From {2} we\\u2019ll also add a NL50 stake so everyone will have a chance to battle it out for supremacy on the felt.\\n\",\n                \"descriptionEventNonMonetary6\": \"This is a poker game unlike anything you\\u2019ve ever seen before - HexaPro Extreme is faster and more adrenaline-filled with Jackpots hitting left and right. We\\u2019ve boosted the 100x multiplier to 125x and it hits 40 times more often than in regular HexaPro. The lowest multiplier games are over in the blink of an eye while we allow for a proper game of poker when you get into the exciting 125x games. \\u20ac1 and \\u20ac10 buy-ins will be available from {0} every Saturday.\",\n                \"descriptionEventNonMonetary7\": \"It\\u2019s time to blast off the biggest tournaments we have to offer, only on Stellar Sunday! The \\u20ac100 buy-in Supernova offers you a chance to send your bankroll to the moon each week and on the first Sunday of the month we also have the Supermoon. This \\u20ac250 buy-in PKO always offers an astronomical first place prize.\\nLook out for the superqualifers running as well, so you can shoot for the stars on a budget.\",\n                \"descriptionEventNonMonetary8\": \"\",\n                \"descriptionEventNonMonetary9\": \"Friday night is fight night as No limit Texas Hold\\u2019em cash games go Banzai! All players start with 10 big blinds and then war commences. From {2} we\\u2019ll also add a NL50 stake so everyone will have a chance to battle it out for supremacy on the felt.\\n\",\n                \"headerText\": \"Daily Specials\",\n                \"nameEvent1\": \"SHORTSTACK MASTER\",\n                \"nameEvent10\": \"TAKEOFF TUESDAY\",\n                \"nameEvent11\": \"STRATOSPHERIC SATURDAY\",\n                \"nameEvent12\": \"FOUR CARD FRENZY\",\n                \"nameEvent13\": \"FLIGHT DAY\",\n                \"nameEvent14\": \"FLIPCLUSIVE WEDNESDAY\",\n                \"nameEvent2\": \"BUBBLE BURSTER\",\n                \"nameEvent3\": \"WILD WEDNESDAY\",\n                \"nameEvent4\": \"DEEPSTACK LEGEND\",\n                \"nameEvent5\": \"BANZAI BONANZA!\",\n                \"nameEvent6\": \"HEXAPRO EXTREME\",\n                \"nameEvent7\": \"STELLAR SUNDAY\",\n                \"nameEvent8\": \"FRENCH POKER CUP\",\n                \"nameEvent9\": \"BANZAI BONANZA!\",\n                \"noMoreGamesForToday\": \"No more active games scheduled for today\",\n                \"textDoNotShow\": \"Do not show {0} info again\",\n                \"textEnds\": \"End:\",\n                \"textFirstStarts\": \"First starts:\",\n                \"textLastStarts\": \"Last starts:\",\n                \"textStarts\": \"Starts:\"\n            }\n        },\n        \"pageTitle\": {\n            \"dailySpecials\": \"Daily Specials\",\n            \"serviceMessage\": \"Service Message\"\n        }\n    }\n}"
          },
