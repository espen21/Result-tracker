            "size": 628650,
            "mimeType": "text/plain",
            "text": "{\n    \"7\": \"31 DAYS OF CHRISTMAS\",\n    \"Ends after blind level\": \"Seat\",\n    \"Uko\\u0144cz {0} misji od {1} grudnia do {2} grudnia\": \"Get a ticket to \\u20ac1500 Turbo tournament by completing 1 more mission by December {0}\",\n    \"anniversaryPopup\": {\n        \"comebackText\": \"Come back Friday for more 1 Year Anniversary missions\",\n        \"label\": {\n            \"header\": \"1 YEAR ANNIVERSARY\",\n            \"promoCompletionInstructions\": \"Complete all four weekend missions of 1 Year Anniversary\",\n            \"weekCompletionInstructions\": \"Complete this weekend mission for 1 Year Anniversary freeroll\"\n        },\n        \"promotionReward\": \"Very special avatar\"\n    },\n    \"appCustomRatingView\": {\n        \"text\": {\n            \"buttonNo\": \"Not Really\",\n            \"buttonYes\": \"Yes!\",\n            \"scene0\": \"Do you enjoy {0}?\",\n            \"scene1\": \"Can we ask you to rate {0} in the {1}?\",\n            \"scene2\": \"Do you want to share your feedback with us?\"\n        }\n    },\n    \"banzai20LobbyView\": {\n        \"text\": {\n            \"highScoreToday\": \"Top stacks in pool:\"\n        }\n    },\n    \"banzai20ProgressToLevelUpView\": {\n        \"text\": {\n            \"gotBlackBelt\": \"You got the Black Belt\",\n            \"masteredBanzai\": \"You've mastered Banzai\",\n            \"youAreSensei\": \"You are the Sensei\"\n        }\n    },\n    \"bonusShop\": {\n        \"2seat\": \"2 Seat\",\n        \"5seat\": \"5 Seat\",\n        \"amount\": \"Amount\",\n        \"banzai\": \"Banzai\",\n        \"banzaiCash\": \"Banzai CG Tickets\",\n        \"banzaiCashSubfilter\": \"Banzai Stakes\",\n        \"banzaiHoldEm\": \"Texas\",\n        \"banzaiOmaha\": \"Omaha\",\n        \"bonus\": \"Playthrough Bonus\",\n        \"bubbleBuster\": \"Bubble buster\",\n        \"bundles\": \"Bundles\",\n        \"buy\": \"Buy\",\n        \"cash\": \"Cash Game Tickets\",\n        \"cashVoucher\": \"Cash\",\n        \"cashVoucherPage\": {\n            \"description\": \"Cash will automatically be credited to your Unibet account.\"\n        },\n        \"dso\": \"DSO\",\n        \"expires\": \"Expires in {days} days\",\n        \"expires2\": \"Expires in {0} days\",\n        \"expiresInUndefinedDate\": \"Expires in ...\",\n        \"faq\": \"FAQ\",\n        \"generic\": \"Generic\",\n        \"hexapro\": \"HexaPro\",\n        \"home\": \"Home\",\n        \"howManyTicketsToPurchase\": \"How many items would you like to buy?\",\n        \"hpBanzai\": \"HexaPro Banzai\",\n        \"hpTrad\": \"HexaPro\",\n        \"jpsng\": \"HexaPro\",\n        \"mtt\": \"MTT\",\n        \"omaha\": \"Omaha\",\n        \"playBonus\": {\n            \"description\": \"Your playthrough bonus is released in increments depending on how much you play and the stakes you play. The higher stakes the faster it will be released.\"\n        },\n        \"remainsActiveIfUsedInDays\": \"Remain active if used at least once per {0} days\",\n        \"saturdayStack\": \"Saturday Stack\",\n        \"seeFlopsToUnlockMoney\": \"See {0} flops to unlock the money\",\n        \"sng\": \"SNG\",\n        \"sngLong\": \"Sit & Go\",\n        \"sundayEntitled\": \"Sunday Entitled\",\n        \"texasHoldEm\": \"Texas Hold\\u2019em\",\n        \"tournament\": \"Tournament Tickets\",\n        \"ukTour\": \"UK Tour\",\n        \"unibetLiveEvents\": \"Unibet live events\",\n        \"unibetOpen\": \"Unibet Open\"\n    },\n    \"buyInPopup\": {\n        \"label\": {\n            \"feeIncluded\": \"Fee included:\"\n        },\n        \"phaseInfoNoDate\": \"Note that by playing this tournament, you will automatically participate also in phase 2, if you progress to it\",\n        \"phaseInfoWithDate\": \"Note that by playing this tournament, you will automatically participate in phase 2 on\\n {0}, if you progress to it\"\n    },\n    \"cashierview\": {\n        \"window\": {\n            \"title\": \"Cashier\"\n        }\n    },\n    \"casinoList\": {\n        \"casinoLobby\": \"Casino Lobby\",\n        \"emptyGamesList\": \"No games found\",\n        \"home\": \"home\",\n        \"jackpot\": \"jackpot games\",\n        \"moreGames\": \"More games\",\n        \"play\": \"play\",\n        \"pokerLobby\": \"Poker Lobby\",\n        \"slot\": \"slots\",\n        \"table\": \"table games\",\n        \"video\": \"video poker\"\n    },\n    \"challenges\": {\n        \"bonus\": \"Bonus Points\",\n        \"bonusNextPayout\": \"(Next payout: {amount})\",\n        \"bonusShop\": \"Enter the Bonus Shop\",\n        \"bonusTableNextPayout\": \"(Next payout: {0})\",\n        \"challengesButton\": \"Challenges\",\n        \"discard\": \"Discard this challenge\",\n        \"discardQuestion\": \"You can only discard two Challenges of this type per month. Are you sure you want to discard this challenge?\",\n        \"estimatedPoints\": \"Estimated Points\",\n        \"gameTypes\": {\n            \"banzai\": \"Banzai Texas\",\n            \"banzaiOmaha\": \"Banzai Omaha\",\n            \"nlhe\": \"Texas Hold'em\",\n            \"plo\": \"Omaha\",\n            \"sng5Max\": \"5 Seat SNG\",\n            \"sngHU\": \"2 Seat SNG\"\n        },\n        \"glossary\": \"Glossary\",\n        \"instructions\": {\n            \"1\": \"Complete all the steps of a challenge to earn points and get a new challenge\",\n            \"2\": \"Earn additional points for playing tournaments\",\n            \"3\": \"Points and Challenges reset each quarter\"\n        },\n        \"majorChallenge\": \"Major Challenge\",\n        \"majorShort\": \"Major\",\n        \"minorChallenge\": \"Minor Challenge\",\n        \"minorShort\": \"Minor\",\n        \"points\": \"Points\",\n        \"reset\": \"Next Reset:\",\n        \"rewards\": \"Rewards\",\n        \"skipThis\": \"Skip this\",\n        \"youHaveNoChallenges\": \"You have no Challenges\",\n        \"yourPoints\": \"Your points\",\n        \"yourPointsWithColon\": \"Your points:\"\n    },\n    \"cip\": {\n        \"preloader\": {\n            \"system_error\": \"Technical error. Please try to start the selected game later.\"\n        }\n    },\n    \"combinedPromoView\": {\n        \"pageTitle\": {\n            \"leaderboards\": \"Leaderboards\"\n        },\n        \"text\": {\n            \"promotionsOptOut\": \"You have choosen to opt-out from promotions.\\nMore info is available on {c2}Your Account {c1}page on Unibet site.\"\n        }\n    },\n    \"commom\": {\n        \"notification\": {\n            \"casino_game_cant_open_active_table\": \"Casino game can\\u2019t be opened if you have at least 1 active table running\",\n            \"hand_replayer_cant_open\": \"Hand Replayer can\\u2019t be used if you have at least 1 active table running\",\n            \"launched_casino_games_limit_reached\": \"You already have {0} casino game(s) open. Due to regulation new game cannot be opened.\",\n            \"maxAppWindowsReached\": \"You can open up to {0} windows at a time!\",\n            \"max_table_reached\": \"You can play up to %d tables at a time and already have %d active tables running\",\n            \"max_table_reached_switch_device\": \"You can play up to %d tables at a time, but have more that %d active tables running. %d tables that were launched earlier will open.\",\n            \"rail_table_cant_open\": \"Observing can\\u2019t be used if you have at least 1 active table running\"\n        },\n        \"questions\": {\n            \"logout_no_active_games\": \"Are you sure you want to log out?\",\n            \"logout_table_active\": \"Are you sure you want to log out? Any games currently in play will be closed.\"\n        }\n    },\n    \"common\": {\n        \"all\": \"All\",\n        \"finish\": \"Finish\",\n        \"gameType\": {\n            \"omaha\": \"Omaha\",\n            \"texas\": \"Texas Hold'em\"\n        },\n        \"hexaproVariant\": {\n            \"extreme\": \"Extreme\",\n            \"hpudso\": \"UDSO\",\n            \"ploExtreme\": \"HexaPLO\"\n        },\n        \"loadMore\": \"Load more...\",\n        \"message\": {\n            \"disconnectedWithReconnection\": \"Disconnect detected, attempting to reconnect.\",\n            \"reconnectionAttemptsLeft\": \"Reconnection attempts left: {0}\"\n        },\n        \"new\": \"New\",\n        \"notification\": {\n            \"cannotStartMttByTableLimit\": \"Tournament started, but you already have {0} active tables open. Please close one table to get the tournament table open\"\n        },\n        \"ok\": \"OK\",\n        \"questions\": {\n            \"exit_from_app\": \"{c2}Are you sure you want to exit the client?\",\n            \"exit_from_app_active\": \"Are you sure you want to exit the client? Any games currently in play will be closed.\",\n            \"exit_from_app_active_android_toast\": \"Press Back again to exit the client. Any games currently in play will be closed.\",\n            \"exit_from_app_android_toast\": \"Press Back again to exit the client.\"\n        },\n        \"sale\": \"Sale\",\n        \"searchPlaceholder\": \"Search\",\n        \"shorthandHours\": \"hrs\",\n        \"shorthandMinutes\": \"min\",\n        \"streets\": {\n            \"flop\": \"Flop\",\n            \"preflop\": \"Pre-flop\",\n            \"river\": \"River\",\n            \"showdown\": \"Showdown\",\n            \"turn\": \"Turn\"\n        },\n        \"tableTitle\": {\n            \"rail\": \"Spectator\",\n            \"replay\": \"Replay\"\n        },\n        \"tableType\": {\n            \"cash\": \"Cash game\",\n            \"jpsng\": \"HexaPro\",\n            \"mtt\": \"Tournament\",\n            \"sng\": \"SNG\",\n            \"sng2\": \"2 Seat SNG\",\n            \"sng5\": \"5 Seat SNG\",\n            \"sngSeat\": \"{0} Seat\"\n        },\n        \"text\": {\n            \"You\": \"You\",\n            \"all\": \"All\",\n            \"congratulations\": \"Congratulations!\",\n            \"feeWithColon\": \"Fee:\",\n            \"labelGameLab\": \"GAME LAB\",\n            \"levelAbrrevWithNumber\": \"L{0}\",\n            \"maxShort\": \"Max\",\n            \"minShort\": \"Min\",\n            \"missionWithColon\": \"Mission:\",\n            \"monthAbbrev\": {\n                \"month1\": \"Jan\",\n                \"month10\": \"Oct\",\n                \"month11\": \"Nov\",\n                \"month12\": \"Dec\",\n                \"month2\": \"Feb\",\n                \"month3\": \"Mar\",\n                \"month4\": \"Apr\",\n                \"month5\": \"May\",\n                \"month6\": \"Jun\",\n                \"month7\": \"Jul\",\n                \"month8\": \"Aug\",\n                \"month9\": \"Sep\"\n            },\n            \"monthFull\": {\n                \"month1\": \"January\",\n                \"month10\": \"October\",\n                \"month11\": \"November\",\n                \"month12\": \"December\",\n                \"month2\": \"February\",\n                \"month3\": \"March\",\n                \"month4\": \"April\",\n                \"month5\": \"May\",\n                \"month6\": \"June\",\n                \"month7\": \"July\",\n                \"month8\": \"August\",\n                \"month9\": \"September\"\n            },\n            \"next\": \"Next\",\n            \"notAvailableAbbrev\": \"N/A\",\n            \"pointsAbbrev\": \"pts\",\n            \"previous\": \"Previous\",\n            \"qPlayAgain\": \"Play Again?\",\n            \"queueS\": \"Queue(s)\",\n            \"replayLastHand\": \"Replay last hand\",\n            \"rewardWithColon\": \"Reward:\",\n            \"times\": \"times\",\n            \"weekdayAbbrev\": {\n                \"weekday0\": \"S\",\n                \"weekday1\": \"M\",\n                \"weekday2\": \"T\",\n                \"weekday3\": \"W\",\n                \"weekday4\": \"T\",\n                \"weekday5\": \"F\",\n                \"weekday6\": \"S\"\n            },\n            \"weekdayFull\": {\n                \"weekday0\": \"Sunday\",\n                \"weekday1\": \"Monday\",\n                \"weekday2\": \"Tuesday\",\n                \"weekday3\": \"Wednesday\",\n                \"weekday4\": \"Thursday\",\n                \"weekday5\": \"Friday\",\n                \"weekday6\": \"Saturday\"\n            },\n            \"youWonTheTournament\": \"You won the tournament!\",\n            \"youWon_withvalue\": \"You won {0}.\"\n        },\n        \"textLabel\": {\n            \"eligibleGames\": \"Eligible games:\"\n        },\n        \"timer\": {\n            \"lessThanMinutes\": \"<{0} min\",\n            \"minutes\": \"{0} min\"\n        },\n        \"variant\": {\n            \"banzai\": \"Banzai\",\n            \"banzaiOmaha\": \"Banzai Omaha\",\n            \"banzaiTexas\": \"Banzai Texas\",\n            \"fast\": \"Fast\",\n            \"trad\": \"Traditional\"\n        }\n    },\n    \"dailySpecials\": {\n        \"labels\": {\n            \"leaderTitleEvent1\": \"Shortstack Master -\",\n            \"leaderTitleEvent4\": \"Deepstack Legend -\"\n        },\n        \"nudgeMessage\": {\n            \"event1\": {\n                \"text0\": \"Shortstack Master tomorrow from {0}\",\n                \"text1\": \"Shortstack Master live in 15 minutes\",\n                \"text2\": \"Join the Shortstack Master action\"\n            },\n            \"event10\": {\n                \"text0\": \"Takeoff Tuesday HexaPro Extreme low buy-in games tomorrow from {0}\",\n                \"text1\": \"Takeoff Tuesday HexaPro Extreme starting in 5 minutes\",\n                \"text2\": \"Right now: Extreme action at HexaPro tables!\"\n            },\n            \"event11\": {\n                \"text0\": \"Stratospheric Saturday HexaPro Extreme tomorrow from {0}\",\n                \"text1\": \"Stratospheric Saturday HexaPro Extreme starting in 5 minutes\",\n                \"text2\": \"Right now: Stratospheric Saturday Extreme action at HexaPro tables!\"\n            },\n            \"event12\": {\n                \"text0\": \"HexaPLO Extreme tomorrow from {0}\",\n                \"text1\": \"HexaPLO Extreme starting in 5 minutes\",\n                \"text2\": \"Right now: Extreme Omaha action at the HexaPLO tables!\"\n            },\n            \"event13\": {\n                \"text0\": \"Flight Day MTT starting in 5 minutes\"\n            },\n            \"event14\": {\n                \"text0\": \"Get ready! Flipclusive Flip starting in 5 minutes!\"\n            },\n            \"event2\": {\n                \"text0\": \"Bubble Burster tomorrow from {0}\",\n                \"text1\": \"Bubble Burster starting in less than an hour!\",\n                \"text2\": \"Bubble Burster starting in 10 minutes!\",\n                \"text3\": \"Not too late! Bubble Burster late registration still open\"\n            },\n            \"event3\": {\n                \"text0\": \"Wild Wednesday tomorrow from {0}\",\n                \"text1\": \"Wild Wednesday starting in less than an hour!\",\n                \"text2\": \"Wild Wednesday starting in 10 minutes!\",\n                \"text3\": \"Not too late! Wild Wednesday late registration still open\"\n            },\n            \"event4\": {\n                \"text0\": \"Deepstack Legend tomorrow from {0}\",\n                \"text1\": \"Deepstack Legend starting in 15 minutes!\",\n                \"text2\": \"Are you a Deepstack Legend?\"\n            },\n            \"event5\": {\n                \"text0\": \"Banzai Bonanza tomorrow from {0}\",\n                \"text1\": \"Banzai Bonanza starting in 15 minutes\",\n                \"text2\": \"Bonanza at the Banzai tables just now!\"\n            },\n            \"event6\": {\n                \"text0\": \"HexaPro Extreme tomorrow from {0}\",\n                \"text1\": \"HexaPro Extreme starting in 5 minutes\",\n                \"text2\": \"Right now: Extreme action at HexaPro tables!\"\n            },\n            \"event7\": {\n                \"text0\": \"Stellar Sunday tomorrow from {0}\",\n                \"text1\": \"Super Satellite just started! Qualify to Supernova for just \\u20ac10\",\n                \"text2\": \"Supernova and Supernova Light starting in 10 minutes!\",\n                \"text3\": \"Not too late! Supernova late registration still open\"\n            },\n            \"event9\": {\n                \"text0\": \"Banzai Bonanza tomorrow from {0}\",\n                \"text1\": \"Banzai Bonanza starting in 15 minutes\",\n                \"text2\": \"Bonanza at the Banzai tables just now!\"\n            }\n        },\n        \"promoPage\": {\n            \"text\": {\n                \"gameAvailableInLabel\": \"Game available in:\",\n                \"nameEvent1\": \"Short Stack Master\",\n                \"nameEvent10\": \"Takeoff Tuesday\",\n                \"nameEvent11\": \"Stratospheric Saturday\",\n                \"nameEvent12\": \"Four Card Frenzy\",\n                \"nameEvent13\": \"Flight Day\",\n                \"nameEvent14\": \"Flipclusive Wednesday\",\n                \"nameEvent2\": \"Bubble Burster\",\n                \"nameEvent3\": \"Wild Wednesday\",\n                \"nameEvent4\": \"Deep Stack Legend\",\n                \"nameEvent5\": \"Banzai Bonanza!\",\n                \"nameEvent6\": \"HexaPro Extreme\",\n                \"nameEvent7\": \"Stellar Sunday\",\n                \"nameEvent9\": \"Banzai Bonanza!\",\n                \"tomorrowEventDataLabel\": \"Come back tomorrow for:\"\n            }\n        },\n        \"texts\": {\n            \"gameSelectorPageInfoBubbleEvent1\": \"Buy-in from \\u20ac5 (10 big blinds) to \\u20ac10 (20 big blinds) and build the biggest stack playing \\u20ac0.25/\\u20ac0.50 Pot Limit Omaha. Tables are available from {2} every Monday and if you build the biggest stack you\\u2019ll receive a \\u20ac50 cash game ticket, an exclusive avatar and bragging rights the following week. 2 table cap per player.\",\n            \"gameSelectorPageInfoBubbleEvent4\": \"Buy-in from \\u20ac50 (500 big blinds) to \\u20ac100 (1000 big blinds) and build the biggest stack playing \\u20ac0.05/\\u20ac0.10 No Limit Texas Hold\\u2019em. Tables are available from {2} every Thursday and if you build the biggest stack you\\u2019ll receive a \\u20ac100 cash game ticket, an exclusive deepstack avatar and bragging rights the following week. 2 table cap per player.\",\n            \"gameSelectorPageInfoBubbleEvent5\": \"Head into battle with the action packed 10 big blind variant of No Limit Texas Hold\\u2019em. We\\u2019ve added a NL50 stake between {2} so there are even more opportunities to win big!\",\n            \"gameSelectorPageInfoBubbleEvent9\": \"Head into battle with the action packed 10 big blind variant of No Limit Texas Hold\\u2019em. We\\u2019ve added a NL50 stake between {2} so there are even more opportunities to win big!\",\n            \"gameSelectorPageInfoBubbleEventNonMonetary1\": \"Buy-in from \\u20ac5 (10 big blinds) to \\u20ac10 (20 big blinds) and build the biggest stack playing \\u20ac0.25/\\u20ac0.50 Pot Limit Omaha. Tables are available from {2} every Monday and if you build the biggest stack an exclusive avatar and bragging rights the following week. 2 table cap per player.\",\n            \"gameSelectorPageInfoBubbleEventNonMonetary4\": \"Buy-in from \\u20ac50 (500 big blinds) to \\u20ac100 (1000 big blinds) and build the biggest stack playing \\u20ac0.05/\\u20ac0.10 No Limit Texas Hold\\u2019em. Tables are available from {2} every Thursday and if you build the biggest stack you\\u2019ll receive an exclusive deepstack avatar and bragging rights the following week. 2 table cap per player.\",\n            \"gameSelectorPageInfoBubbleEventNonMonetary5\": \"Head into battle with the action packed 10 big blind variant of No Limit Texas Hold\\u2019em. We\\u2019ve added a NL50 stake between {2} so there are even more opportunities to win big!\",\n            \"gameSelectorPageInfoBubbleEventNonMonetary9\": \"Head into battle with the action packed 10 big blind variant of No Limit Texas Hold\\u2019em. We\\u2019ve added a NL50 stake between {2} so there are even more opportunities to win big!\"\n        }\n    },\n    \"dailySpecialsFullView\": {\n        \"bannerMinilabel\": {\n            \"banzaiCG\": \"Banzai CG\",\n            \"hexapro\": \"HexaPro\",\n            \"omahaCG\": \"Omaha CG\",\n            \"texasCG\": \"Texas CG\",\n            \"tournament\": \"Tournament\"\n        },\n        \"bannerText\": {\n            \"event1\": \"Small stacks,\\nbig Omaha action!\",\n            \"event10\": \"Blast off to big prizes!\",\n            \"event11\": \"Jackpots that\\n are out of this world!\",\n            \"event12\": \"Welcome to\\n HexaPLO Extreme\\n \\u2013 the Fastest, Wildest\\n Omaha Experience Yet!\",\n            \"event13\": \"A day full of phases 1,\\n a phase 2 during the evening\",\n            \"event14\": \"It starts with a Flip.\\n It ends with a Payout.\",\n            \"event2\": \"Cash quicker with\\nthese special MTTs!\",\n            \"event3\": \"It's a jungle out there!\",\n            \"event4\": \"Deeper play,\\nbigger stacks!\",\n            \"event5\": \"Unleash\\nyour battle cry!\",\n            \"event6\": \"HexaPro on steroids!\",\n            \"event7\": \"MTT's\\nout of this World\",\n            \"event8\": \"Super satellite \\nstarts at 18:00!\",\n            \"event9\": \"Unleash\\nyour battle cry!\"\n        },\n        \"text\": {\n            \"descriptionEvent1\": \"Become a Shortstack Master playing Pot Limit Omaha from {2} every Monday. Buy in from \\u20ac5 (10 big blinds) to \\u20ac10 (20 big blinds) and build the biggest stack you can! \",\n            \"descriptionEvent10\": \"Faster and more exciting, Hexapro Extreme is fueled up and ready for launch. \\u20ac1 and \\u20ac2 games available from {2}.\",\n            \"descriptionEvent11\": \"It's Hexapro Extreme, but not as you know it. Bigger buy-ins and even bigger prizepools.  \\u20ac10 and \\u20ac20 games available from {2}.\",\n            \"descriptionEvent12\": \"Omaha just hit Extreme mode.\\nGet ready for explosive hands and jackpots up to \\u20ac2,000 \\u2013 all from just \\u20ac2.\",\n            \"descriptionEvent13\": \"All day long, you can play many phases 1 with the goal to qualify for phase 2 that will be the same day in the evening at 21h with a nice guarantee.\",\n            \"descriptionEvent14\": \"Qualify via flips \\u2013 Fast-paced flip tournaments from just \\u20ac2, with higher-value entries at \\u20ac5, \\u20ac10, and \\u20ac25. \\u20ac10,000 guaranteed prize pool \\u2013 All finalists are in the money, with bigger payouts up top.\",\n            \"descriptionEvent2\": \"Bubbler bursters start fast but slow down once you're in the money. \\u20ac1, \\u20ac5 and \\u20ac10 buy-ins available from 19:00 CET/CEST with added prizes for winning more than one at the same buy-in. \",\n            \"descriptionEvent3\": \"Wild  \\u20ac1 and \\u20ac2 buy-in MTTs from 20:00 CET/CEST with rebuys that cost \\u00bc of the buy-in \",\n            \"descriptionEvent4\": \"\\u20ac50-\\u20ac100 (500-1000 big blinds) buy-in deepstack \\u20ac0.05/\\u20ac0.10 tables every Thursday from {2} \",\n            \"descriptionEvent5\": \"10 big blind poker with NL50 stake added between {2} every Friday.\",\n            \"descriptionEvent6\": \"This is a poker game unlike anything you\\u2019ve ever seen before - HexaPro Extreme is faster and more adrenaline-filled with Jackpots hitting left and right. The game is available from {2}.\",\n            \"descriptionEvent7\": \"Stellar MTTs like the \\u20ac100 Supernova with out of this world prizepools.\",\n            \"descriptionEvent8\": \"Take your first step towards becoming the next French Poker Cup champion by playing the super satellite with loads of tickets guaranteed. Starts every Sunday at 18:00 CET/CEST!\",\n            \"descriptionEvent9\": \"10 big blind poker with NL50 stake added between {2} every Friday.\",\n            \"descriptionEventNonMonetary1\": \"Become a Shortstack Master playing Pot Limit Omaha from {2} every Monday. Buy in from \\u20ac5 (10 big blinds) to \\u20ac10 (20 big blinds) and build the biggest stack you can! \",\n            \"descriptionEventNonMonetary10\": \"Faster and more exciting, Hexapro Extreme is fueled up and ready for launch. \\u20ac1 and \\u20ac2 games available from {2}\",\n            \"descriptionEventNonMonetary11\": \"It's Hexapro Extreme, but not as you know it. Bigger buy-ins and even bigger prizepools.  \\u20ac10 and \\u20ac20 games available from {2}\",\n            \"descriptionEventNonMonetary12\": \"Omaha just hit Extreme mode.\\nGet ready for explosive hands and jackpots up to \\u20ac2,000 \\u2013 all from just \\u20ac2.\",\n            \"descriptionEventNonMonetary14\": \"Qualify via flips \\u2013 Fast-paced flip tournaments from just \\u20ac2, with higher-value entries at \\u20ac5, \\u20ac10, and \\u20ac25. \\u20ac10,000 guaranteed prize pool \\u2013 All finalists are in the money, with bigger payouts up top.\",\n            \"descriptionEventNonMonetary2\": \"Bubble Bursters start fast but slow down once you're in the money. \\u20ac1, \\u20ac5 and \\u20ac10 buy-ins available from 19:00 CET/CEST with added prizes for winning more than one at the same buy-in.\",\n            \"descriptionEventNonMonetary3\": \"Wild  \\u20ac1 and \\u20ac2 buy-in MTTs from 20:00 CET/CEST with rebuys that cost \\u00bc of the buy-in.\",\n            \"descriptionEventNonMonetary4\": \"\\u20ac50-\\u20ac100 (500-1000 big blinds) buy-in deepstack \\u20ac0.05/\\u20ac0.10 tables every Thursday from {2} \",\n            \"descriptionEventNonMonetary5\": \"10 big blind poker with NL50 stake added between {2} every Friday.\",\n            \"descriptionEventNonMonetary6\": \"This is a poker game unlike anything you\\u2019ve ever seen before - HexaPro Extreme is faster and more adrenaline-filled. The game is available from {2}.\",\n            \"descriptionEventNonMonetary7\": \"Stellar MTTs like the \\u20ac100 Supernova with out of this world prizepools.\",\n            \"descriptionEventNonMonetary8\": \"\",\n            \"descriptionEventNonMonetary9\": \"10 big blind poker with NL50 stake added between {2} every Friday.\",\n            \"nameEvent1\": \"Shortstack\\nMaster\",\n            \"nameEvent10\": \"Takeoff\\nTuesday\",\n            \"nameEvent11\": \"Stratospheric\\nSaturday\",\n            \"nameEvent12\": \"Four Card\\nFrenzy\",\n            \"nameEvent13\": \"Flight Day\",\n            \"nameEvent14\": \"Flipclusive\\nWednesday\",\n            \"nameEvent2\": \"Bubble\\nBurster\",\n            \"nameEvent3\": \"Wild\\nWednesday\",\n            \"nameEvent4\": \"Deepstack\\nLegend\",\n            \"nameEvent5\": \"Banzai\\nBonanza!\",\n            \"nameEvent6\": \"HexaPro\\nExtreme\",\n            \"nameEvent7\": \"Stellar\\nSunday\",\n            \"nameEvent8\": \"French\\nPoker Cup\",\n            \"nameEvent9\": \"Banzai\\nBonanza!\"\n        }\n    },\n    \"dashboardView\": {\n        \"widget\": {\n            \"bonusShop\": {\n                \"balanceLabel\": \"BALANCE\",\n                \"label\": {\n                    \"enterShop\": \"ENTER SHOP\"\n                },\n                \"titleText\": \"BONUS POINTS\"\n            },\n            \"changeCardDesign\": {\n                \"titleText\": \"Change Card Design\"\n            },\n            \"changeIdentity\": {\n                \"titleText\": \"Stay undercover:\\nChange Identity!\"\n            },\n            \"changeTableBackground\": {\n                \"titleText\": \"Change Table Background\"\n            },\n            \"gameLab\": {\n                \"text\": \"Improve your game!\"\n            },\n            \"genericPromotion\": {\n                \"optInOverlayText\": \"REQUIRES OPT IN\"\n            },\n            \"hexapro21Banner\": {\n                \"textTitle\": \"GET EXACTLY A TOTAL OF 21 IN ACCUMULATED MULTIPLIERS!\",\n                \"textTopPrizeLabelWithColon\": \"Top prize:\",\n                \"textTopPrizeValue\": \"\\u20ac10 000!\"\n            },\n            \"lastPlayedGameButtonText\": \"PLAY AGAIN\",\n            \"leaderboard\": {\n                \"yourPos\": \"Your pos.\"\n            },\n            \"loyalty\": {\n                \"titleText\": \"LOYALTY PROGRESS\"\n            },\n            \"missions\": {\n                \"stepsCompletedWithColon\": \"Steps completed:\",\n                \"titleText\": \"MISSIONS\"\n            },\n            \"mtt\": {\n                \"header\": {\n                    \"buyIn\": \"Buy-In\",\n                    \"name\": \"Name\",\n                    \"time\": \"Time\"\n                },\n                \"titleText\": \"TOURNAMENT HIGHLIGHTS\"\n            },\n            \"neverPlayedBanzai20\": {\n                \"titleText\": \"Got Sensei potential?\"\n            },\n            \"neverPlayedHexapro\": {\n                \"titleText\": \"Win up to 1000x in our Jackpot Sit & Go\"\n            },\n            \"optInBanner\": {\n                \"textDescriptionPlural\": \"There are currently {0} available promotions which you are not opted in to\",\n                \"textDescriptionSingular\": \"There is currently 1 available promotion which you are not opted in to\",\n                \"textTitle\": \"DON'T MISS OUT!\"\n            },\n            \"playthroughBonus\": {\n                \"progress\": \"{0} to unlock {1} cash\",\n                \"titleText\": \"BONUS PROGRESS\"\n            },\n            \"tickets\": {\n                \"text\": \"You have ticket(s) that are about to expire!\"\n            },\n            \"tokenTier\": {\n                \"titleText\": \"Promo tokens earned\",\n                \"totalBronze\": \"Total bronze tokens\",\n                \"totalDiamond\": \"Total diamond tokens\",\n                \"totalGold\": \"Total gold tokens\",\n                \"totalSilver\": \"Total silver tokens\"\n            }\n        }\n    },\n    \"dateFromNow\": {\n        \"today\": \"today\",\n        \"tomorrow\": \"tomorrow\"\n    },\n    \"daysOfChristmasFullViewPopup\": {\n        \"label\": {\n            \"subHeader\": \"Completed missions fully visible and highlighted in color\"\n        }\n    },\n    \"daysOfChristmasPopup\": {\n        \"additionalMission\": {\n            \"description\": \"Complete 25 missions in December\",\n            \"reward\": \"Ticket to a \\u20ac3k freeroll in January\",\n            \"unibetfr\": {\n                \"description\": \"Complete 14 missions in December\",\n                \"reward\": \"Freeroll ticket where you can win a \\u20ac5k French Cup final ticket\"\n            }\n        },\n        \"label\": {\n            \"allDatesButton\": \"ALL DATES\",\n            \"extraMonthlyMissionDesc\": {\n                \"com\": \"Complete 20 missions in December to get access to a \\u20ac4K freeroll in January.\",\n                \"fr\": \"Complete 15 missions in December to get freeroll ticket where you can win a \\u20ac5k French Cup final ticket.\"\n            },\n            \"extraWeeklyMissionDesc\": \"Get a ticket to \\u20ac2000 Turbo tournament by completing 5 missions by December {0}.\",\n            \"extraWeeklyNextMissionDesc\": \"Get a ticket to \\u20ac2000 Turbo tournament by completing 5 missions between December {0} and December {1}.\",\n            \"firstWeekPrize\": \"Get a ticket to \\u20ac1500 Turbo tournament by completing 5 missions by end of December 6\",\n            \"header\": \"31 DAYS OF CHRISTMAS\",\n            \"restWeeksPrizePlural\": \"Complete {0} missions from December {1} to December {2}\"\n        },\n        \"weeklyMission\": {\n            \"description\": \"Complete {0} missions from December {1} to December {2}\",\n            \"descriptionProgress\": \"Complete {0} more missions till the end of December {1} UTC\",\n            \"reward\": \"Ticket to \\u20ac1000 Turbo tournament\"\n        }\n    },\n    \"daysOfPromoPopup\": {\n        \"additionalMission18\": {\n            \"description\": \"Complete 18 missions by March 17\",\n            \"reward\": \"Exclusive Ticket to a \\u20ac10,000 Freeroll!\"\n        },\n        \"additionalMission21\": {\n            \"description\": \"Complete 21 missions by March 17\",\n            \"reward\": \"Exclusive new Table Background!\"\n        },\n        \"label\": {\n            \"header\": \"21 Days of Anniversary Missions\"\n        }\n    },\n    \"dialogs\": {\n        \"connectionDialogs\": {\n            \"loggedOut\": {\n                \"text\": \"You're logged out\"\n            },\n            \"loginFailed\": {\n                \"text\": \"Login failed\"\n            },\n            \"reconnecting\": \"Trying to reconnect...\",\n            \"serverShutdown\": {\n                \"text\": \"The server was shut down\"\n            },\n            \"sessionConflict\": {\n                \"text\": \"Your session has ended, either due to inactivity or login on another device.\\nPlease login again to continue on this device.\"\n            },\n            \"unknownError\": {\n                \"text\": \"Unknown error\"\n            }\n        }\n    },\n    \"gameLab\": {\n        \"achPageLevel2\": {\n            \"gameTypeAbbrev0\": \"CG\",\n            \"gameTypeAbbrev1\": \"SnG\",\n            \"gameTypeAbbrev2\": \"MTT\",\n            \"gameTypeAbbrev3\": \"HexaPro\",\n            \"gameTypeLong0\": \"Cash Game\",\n            \"gameTypeLong1\": \"Sit & Go\",\n            \"gameTypeLong2\": \"Tournaments\",\n            \"gameTypeLong3\": \"HexaPro\",\n            \"leftPartTitle\": \"Formats you've played\",\n            \"rightPartTitle\": \"Overall hands dealt per format\"\n        },\n        \"achPageLevel3\": {\n            \"channelType0\": \"Desktop Web\",\n            \"channelType1\": \"Desktop App\",\n            \"channelType2\": \"Mobile Web\",\n            \"channelType3\": \"Mobile App\",\n            \"channelType4\": \"Web Browser\",\n            \"leftPartTitle\": \"Clients you've played\",\n            \"rightPartTitle\": \"Overall traffic per channel\"\n        },\n        \"achPageLevel4\": {\n            \"allTimeBest\": \"Your all\\ntime best\",\n            \"daysThisWeek\": \"Days this\\nweek\",\n            \"weeksInARow\": \"Weeks\\nin a row\"\n        },\n        \"achPageLevel7\": {\n            \"cashGameHands\": \"Cash Game Hands\"\n        },\n        \"achievements\": {\n            \"pageSubTitle\": {\n                \"level1\": \"Milestone clubs\",\n                \"level2\": \"Info\",\n                \"level3\": \"Info\",\n                \"level4\": \"50 hands\",\n                \"level5\": \"Preflop situations\",\n                \"level6\": \"In Big Blinds\",\n                \"level7\": \"Most played in one day\"\n            },\n            \"pageTitle\": {\n                \"level1\": \"Hands Played\",\n                \"level2\": \"Game Formats\",\n                \"level3\": \"Clients\",\n                \"level4\": \"Streak\",\n                \"level5\": \"All-In Luck\",\n                \"level6\": \"Biggest Stack\",\n                \"level7\": \"Personal Records\"\n            }\n        },\n        \"banzai20\": {\n            \"pageSubTitle\": {\n                \"level1\": \"Belts reached\",\n                \"level2\": \"Big pots\"\n            },\n            \"pageTitle\": {\n                \"level1\": \"Avatar Collection\",\n                \"level2\": \"Heaviest Hits\"\n            }\n        },\n        \"banzai20PageLevel1\": {\n            \"leftPartText\": \"Black Belt achieved\",\n            \"rightPartText\": \"Sensei state achieved\"\n        },\n        \"banzai20PageLevel2\": {\n            \"leftPartText\": \"Your largest net win:\",\n            \"rightPartText\": \"Your largest net win in BB:\"\n        },\n        \"hexapro\": {\n            \"pageTitle\": {\n                \"level2\": \"Dashboard\"\n            }\n        },\n        \"hexaproPage\": {\n            \"latestGames\": \"Latest games\",\n            \"multiplerGraph\": \"Multiplier graph\",\n            \"multiplerGraphInfoText\": \"Shows last {0} games. 500 maximum.\",\n            \"multiplerGraphUnlockText\": \"Play {0} games to unlock ({1})\",\n            \"multipliersPlayed\": \"Multipliers played\",\n            \"tournamentsPlayed\": \"Tournaments played\",\n            \"winnings\": \"Winnings\"\n        },\n        \"hof\": {\n            \"pageSubTitle\": {\n                \"level1\": \"Big games\",\n                \"level2\": \"Big pots\",\n                \"level3\": \"Largest prizepools\",\n                \"level4\": \"Moments of Glory\",\n                \"level5\": \"Cooler deluxe\",\n                \"level6\": \"Leaderboard\",\n                \"level7\": \"Consistency\"\n            },\n            \"pageTitle\": {\n                \"level1\": \"HexaPro\",\n                \"level2\": \"Cash Games\",\n                \"level3\": \"Tournaments\",\n                \"level4\": \"Royal Flushes\",\n                \"level5\": \"Bad Beat\",\n                \"level6\": \"XP\",\n                \"level7\": \"Level 7 Top Dogs\"\n            }\n        },\n        \"hofPageLevel1\": {\n            \"rightPartText1\": \"Your biggest HexaPro 1st prize win:\",\n            \"rightPartText2\": \"Your biggest multiplier win:\"\n        },\n        \"hofPageLevel2\": {\n            \"leftPartText\": \"Your largest net win:\",\n            \"rightPartText\": \"Your largest net win in BB:\"\n        },\n        \"hofPageLevel3\": {\n            \"rightPartText\": \"Your biggest 1st place finish ever:\"\n        },\n        \"hofPageLevel4\": {\n            \"bottomText\": \"Your best hand ever / latest royal flush:\"\n        },\n        \"hofPageLevel5\": {\n            \"bottomText\": \"Your worst bad beat ever:\"\n        },\n        \"hofPageLevel7\": {\n            \"bottomText\": \"Your current streak:\"\n        },\n        \"infoPopupText\": {\n            \"010000\": \"{c2}Called bets {c1}shows % of total hands that you call before the flop.\\n{c2}Raised bets {c1}shows % of total hands that you raise before the flop.\\n\\nStat shows this month's result as well as last month's result.\\n\\nNB! Any advice given in gamelab is generated based on your current stat. The stats will more accurately reflect your gameplay as you play more hands.\",\n            \"010001\": \"{c2}Continuation bet {c1}shows % of hands where you followed up with a bet on the flop after raising before the flop.\\n\\nStat shows this month's result as well as last month's result.\\n\\n{c2}Alias change {c1}displays the number of aliases you have used in total as well as days since your alias was last changed.\\n\\nNB! Any advice given in gamelab is generated based on your current stat. The stats will more accurately reflect your gameplay as you play more hands.\",\n            \"010002\": \"{c2}Re-raise {c1}shows % of hands where you raise when faced with a single raise preflop (3-bet)\\n{c2}Fold to re-raise {c1}shows % of hands where you raised a hand which you end up folding when faced with a raise on top from another player. (Fold to 3-bet)\\n\\nStat shows this month's result as well as last month's result.\\n\\nNB! Any advice given in gamelab is generated based on your current stat. The stats will more accurately reflect your gameplay as you play more hands.\",\n            \"010003\": \"{c2}Position meter {c1}shows your % of hands played from different positions on the table.\\nBTN = Button (when you have the dealer button), CO = Cut-off (right side of the player with the dealer button), MP = Middle position, UTG = Under the gun (first to act)\\n{c2}Showdown {c1}shows % of hands that go to showdown after you reach the flop.\\n\\nStat shows this month's result as well as last month's result.\\n\\nNB! Any advice given in gamelab is generated based on your current stat. The stats will more accurately reflect your gameplay as you play more hands.\",\n            \"010100\": \"{c2}Preflop call % from blinds when deep stack {c1}shows % of hands where you call before the flop from the small or big blind with effective stack >=17 big blinds.\\n{c2}Preflop raised All-ins vs Called All-ins {c1}shows % of hands where you were all-in for your tournaments life, that you raised all-in vs the hands where you called an all-in preflop. Stat include all situations where you were all-in for your tournament life, even if not called.\\n\\n\\nStat shows this month's result as well as last month's result.\\n\\nNB! Any advice given in gamelab is generated based on your current stat. The stats will more accurately reflect your gameplay the more hands you have played. Please note that HexaPro Extreme is not included in the stats.\",\n            \"010101\": \"{c2}Preflop call with an effective stack of <=10 big blinds {c1}shows how often you call in a situation where your or your opponent's stack is 10 big blinds or less.\\n{c2}Preflop raise with an effective stack of <=10 big blinds {c1}shows how often you raise in a situation where your or your opponent's stack is 10 big blinds or less.\\n\\nStat shows this month's result as well as last month's result.\\n\\nNB! Any advice given in gamelab is generated based on your current stat. The stats will more accurately reflect your gameplay as you play more hands. Please note that HexaPro Extreme is not included in the stats.\",\n            \"010102\": \"{c2}Chip leader when heads up starts {c1}shows the % of time you have more chips than your opponent when reaching heads up play.\\n{c2}Average play time when lowest multiplier {c1}shows how many seconds of play you have on average when the game is of the lowest multiplier.\\n\\nStat shows this month's result as well as last month's result.\\n\\nNB! Any advice given in gamelab is generated based on your current stat. The stats will more accurately reflect your gameplay as you play more hands. Please note that HexaPro Extreme is not included in the stats.\",\n            \"010103\": \"{c2}Win heads up {c1}shows the % of Hexapros you win after reaching heads up.\\n{c2}Average preflop all-in equity {c1}shows average all-in equity of the hands where you were all-in (for your tournament life) before the flop. 2 way all-ins only included in the stat.\\n\\nStat shows this month's result as well as last month's result.\\n\\nNB! Any advice given in gamelab is generated based on your current stat. The stats will more accurately reflect your gameplay as you play more hands. Please note that HexaPro Extreme is not included in the stats.\",\n            \"020000\": \"{c2}Hands Played - Milestone Clubs {c1}display the amount of hands you have played in total across all game formats. You can see the progression towards the next milestone and how many players have reached that milestone.\\nNB! Records shown are tracked from when gamelab went live.\",\n            \"020001\": \"{c2}Game formats - Info {c1}display the formats available and if you have tried them. It also shows the overall amount of hands dealt per format for the full player pool.\\nNB! Records shown are tracked from when gamelab went live.\",\n            \"020002\": \"{c2}Channels - Info {c1}display the channels available and which ones you have played from. It also shows the overall traffic per channel for the full player pool.\\nNB! Records shown are tracked from when gamelab went live.\",\n            \"020003\": \"{c2}Streak - 50 hands {c1}display the number of weeks in a row where you have played 50 hands for 3, 5 and 7 days. This week's result, how many weeks in a row and your personal record streak.\\nNB! Records shown are tracked from when gamelab went live.\",\n            \"020004\": \"{c2}All-in luck - Preflop situations {c1}displays your 1v1 all ins preflop won and lost across all formats this month. You can also find your record from last month.\\nNB! Records shown are tracked from when gamelab went live.\",\n            \"020005\": \"{c2}Biggest stack - In Big Blinds {c1}display achievements that you unlock by reaching a certain amount of big blinds in a cash-game stack. It shows your current record and how many players have completed the achievements.\\nNB! Records shown are tracked from when gamelab went live. Deepstack Legend cash games are not included here. \",\n            \"020006\": \"{c2}Personal Records - Most played in one day {c1}display your record days in volume across all formats.\\nNB! Results shown are tracked from when gamelab went live.\",\n            \"030000\": \"{c2}HexaPro - Big games {c1}display the 3 biggest HexaPros played over the last 30 days.\\nYou will also find your personal records here. Your biggest HexaPro prizepool and biggest multiplier win.\\n\\nYou can replay the last hand of these HexaPros by clicking the replay arrow.\\n\\nNB! Records shown are tracked from when gamelab went live. Please note that HexaPro Extreme is not included in the stats.\\n\",\n            \"030001\": \"{c2}Cash Games - Big pots {c1}display the 3 biggest Cash Game pots played and 3 biggest pots in BB over the last 30 days.\\nYou will also find your personal records here. Your most valuable win and the biggest pot in BB that you have won.\\n\\nYou can replay these hands by clicking the replay arrow.\\n\\nNB! Records shown are tracked from when gamelab went live. Deepstack Legend cash games are not included in the BB stats.\",\n            \"030002\": \"{c2}Tournaments - Largest prizepools{c1} display the 3 biggest Tournament scores in the last 30 days.\\nYou will also find your personal record here. Your biggest 1st place MTT finish ever.\\nYou can replay these hands by clicking the replay symbol.\\nNB! Records shown are tracked from when gamelab went live.\",\n            \"030003\": \"{c2}Royal Flushes - Moments of glory {c1}display the latest royal flushes overall as well as your best hand ever / last time you had a royal flush.\\nYou can replay these hands by clicking the replay symbol.\\nNB! Records shown are tracked from when gamelab went live.\",\n            \"030004\": \"{c2}Bad Beat - Cooler deluxe {c1}displays the best hand that didn\\u2019t win the pot yesterday as well as your best hand that didn\\u2019t win the pot ever.\\nYou can replay these hands by clicking the replay symbol.\\nNB! Records shown are tracked from when gamelab went live.\",\n            \"030005\": \"{c2}XP - Leaderboard {c1}displays the top players current quarter in terms of XP\\u00b4s earnt. It also shows your position in the leaderboard.\",\n            \"030006\": \"{c2}L7 Top dogs - Consistency {c1}displays the players with most consecutive quarters reaching Level 7. It also shows your streak, how many quarters in a row you\\u2019ve reached Level 7. If there is a tie, the players first reaching level 7 will be shown on the podium. Same goes for next quarter.\",\n            \"040000\": \"{c2}Dashboard {c1}shows various results related to your HexaPro gameplay.\\nLast 8 games, results and multiplier. Total number of HexaPros played and how much you\\u2019ve collectively won in them. \\nTimes in different multipliers and a graph showing how you are running with the multipliers compared with expected results. Please note that HexaPro Extreme is not included in the stats.\",\n            \"050000\": \"{c2}Dashboard {c1}shows various results related to your tournament gameplay.\\nTotal number of tournaments played, how many % of those you finished in the money and your total winnings from those tournaments including bounties collected.\\nBig field success shows your 1st, 2nd and 3rd place finishes in tournaments with 100 or more players.\\nHattrick hero = finish in the money in three consecutive tournaments, by starting time. (satelites excluded)\\nStrike team = win ten tournaments (satellites excluded)\",\n            \"060000\": \"{c2}Avatar Collection - Belts reached {c1}Shows the current belts you\\u2019ve unlocked in Banzai. You level up in Banzai by either going all-in or calling an all-in. All hands where at least one player is all-in and you are still in the hand at showdown count towards your progression. The more all-ins you see, the more belts you\\u2019ll unlock. This page also shows the total days that you became a black belt and the total days you reached Sensei state. Sensei state is achieved by having the biggest stack in the entire player pool at the buy-in level you\\u2019re playing at. There is a minimum requirement of having at least a 50 big blind stack in order to qualify as Sensei state.\",\n            \"060001\": \"{c2}Heaviest Hits - Big pots{c1} Shows the biggest overall pots from Banzai within the last 30 days, both in Euros and in Big blinds. It also shows your biggest net win ever in Banzai, both in Euros and Big Blinds.\"\n        },\n        \"label\": {\n            \"currentClub\": \"Current Club\",\n            \"handsPlayed\": \"Hands played\",\n            \"lost\": \"Lost\",\n            \"noClubYet\": \"No Club Yet\",\n            \"won\": \"Won\",\n            \"yourLevel\": \"Your level\"\n        },\n        \"logoText\": {\n            \"leaderboard\": \"LEADERBOARD\",\n            \"tournament\": \"TOURNAMENT\"\n        },\n        \"mtt\": {\n            \"pageTitle\": {\n                \"level2\": \"Dashboard\"\n            }\n        },\n        \"mttPage\": {\n            \"bigFieldSuccess\": \"Big field success\",\n            \"hatTrickHero\": \"HATTRICK HERO\",\n            \"inARow\": \"In the money, in a row\",\n            \"percentItm\": \"In The Money %\",\n            \"strikeTeam\": \"STRIKE TEAM\",\n            \"tournamentWins\": \"MTT wins\"\n        },\n        \"school\": {\n            \"cashGames\": {\n                \"pageTitle\": {\n                    \"level1\": \"Preflop Actions\",\n                    \"level2\": \"Continuation Bet / Alias Change\",\n                    \"level3\": \"Advanced Preflop Actions\",\n                    \"level4\": \"Position Meter / Showdown\"\n                }\n            },\n            \"hexapro\": {\n                \"pageTitle\": {\n                    \"level1\": \"Preflop Action from Blinds / Preflop All-In\",\n                    \"level2\": \"Preflop low Big Blind play\",\n                    \"level3\": \"Chip leader Heads-Up / Average play time when lowest multiplier\",\n                    \"level4\": \"Win Heads-Up / Average Preflop All-In equity\"\n                }\n            },\n            \"texas\": {\n                \"activeDaysWithAvatar\": {\n                    \"level2\": \"Active days with current alias\"\n                },\n                \"aliasesUsed\": {\n                    \"level2\": \"Aliases\\nused\"\n                },\n                \"explanation\": {\n                    \"level2Right\": \"Fly under the radar of good players by changing your alias regularly!\"\n                },\n                \"level4\": {\n                    \"position0\": \"BTN\",\n                    \"position1\": \"CO\",\n                    \"position2\": \"MP\",\n                    \"position3\": \"UTG\"\n                }\n            }\n        },\n        \"schoolPage\": {\n            \"header\": {\n                \"hexapro\": {\n                    \"pageL1Left\": \"PREFLOP CALL FROM BLINDS WITH MANY BIG BLINDS\",\n                    \"pageL1Right\": \"PREFLOP RAISED ALL-IN VS CALLED ALL-INS\",\n                    \"pageL2Left\": \"PREFLOP CALL WITH OR AGAINST <=10 BIG BLINDS\",\n                    \"pageL2Right\": \"PREFLOP RAISE WITH OR AGAINST <=10 BIG BLINDS\",\n                    \"pageL3Left\": \"CHIP LEADER WHEN HEADS-UP STARTS\",\n                    \"pageL3Right\": \"AVERAGE PLAYTIME WHEN LOWEST MULTIPLIER\",\n                    \"pageL4Left\": \"WIN HEADS UP\",\n                    \"pageL4Right\": \"AVERAGE PREFLOP\\nALL-IN EQUITY\"\n                },\n                \"texas\": {\n                    \"pageL1Left\": \"Call Preflop\",\n                    \"pageL1Right\": \"Raise Preflop\",\n                    \"pageL2Left\": \"BET FLOP WHEN RAISE PREFLOP\",\n                    \"pageL3Left\": \"RE-RAISE\",\n                    \"pageL3Right\": \"FOLD TO RE-RAISE\",\n                    \"pageL4Left\": \"POSITION METER\",\n                    \"pageL4Right\": \"SHOWDOWN WHEN FLOP SEEN\"\n                }\n            },\n            \"hexapro\": {\n                \"genericUnlockInfo\": \"Unlocks after {0} HexaPro games (every month)\"\n            },\n            \"lastMonth\": \"Last month\",\n            \"suggestion0\": \"SYSTEM OK\",\n            \"suggestion1\": \"CONSIDER CALLING MORE HANDS PREFLOP\",\n            \"suggestion10\": \"CONSIDER BETTING ON THE FLOP AFTER RASING PREFLOP LESS OFTEN\",\n            \"suggestion11\": \"BET ON THE FLOP AFTER RASING PREFLOP LESS OFTEN\",\n            \"suggestion12\": \"RE-RAISE MORE PREFLOP\",\n            \"suggestion13\": \"CONSIDER RE-RAISING MORE PREFLOP\",\n            \"suggestion14\": \"CONSIDER RE-RAISING LESS PREFLOP\",\n            \"suggestion15\": \"RE-RAISE LESS PREFLOP\",\n            \"suggestion16\": \"FOLD TO RE-RAISE MORE PREFLOP\",\n            \"suggestion17\": \"CONSIDER FOLDING MORE TO RE-RAISE PREFLOP\",\n            \"suggestion18\": \"CONSIDER FOLDING LESS TO RE-RAISE PREFLOP\",\n            \"suggestion19\": \"FOLD TO RE-RAISE LESS PREFLOP\",\n            \"suggestion2\": \"CONSIDER CALLING LESS HANDS PREFLOP\",\n            \"suggestion20\": \"GET TO SHOWDOWN MORE OFTEN\",\n            \"suggestion21\": \"CONSIDER GETTING TO SHOWDOWN MORE OFTEN\",\n            \"suggestion22\": \"CONSIDER GETTING TO SHOWDOWN LESS OFTEN\",\n            \"suggestion23\": \"GET TO SHOWDOWN LESS OFTEN\",\n            \"suggestion24\": \"CALL MORE PREFLOP WHEN DEEP STACKED\",\n            \"suggestion25\": \"CONSIDER CALLING MORE PREFLOP WHEN DEEP STACKED\",\n            \"suggestion26\": \"CONSIDER CALLING LESS PREFLOP WHEN DEEP STACKED\",\n            \"suggestion27\": \"CALL LESS PREFLOP WHEN DEEP STACKED\",\n            \"suggestion28\": \"RAISING ALL-IN IS OFTEN BETTER THAN CALLING AN ALL-IN\",\n            \"suggestion29\": \"CONSIDER RAISING ALL-IN MORE OFTEN COMPARED TO CALLING AN ALL-IN\",\n            \"suggestion3\": \"CALL LESS HANDS PREFLOP\",\n            \"suggestion30\": \"CONSIDER RAISING ALL-IN LESS OFTEN COMPARED TO CALLING AN ALL-IN\",\n            \"suggestion31\": \"YOU SHOULD RAISE ALL-IN LESS OFTEN\",\n            \"suggestion32\": \"CALL MORE PREFLOP WHEN SHORT STACKED\",\n            \"suggestion33\": \"CONSIDER CALLING MORE PREFLOP WHEN SHORT STACKED\",\n            \"suggestion34\": \"CONSIDER CALLING LESS PREFLOP WHEN SHORT STACKED\",\n            \"suggestion35\": \"CALL LESS PREFLOP WHEN SHORT STACKED\",\n            \"suggestion36\": \"RAISE MORE PREFLOP WHEN SHORT STACKED\",\n            \"suggestion37\": \"CONSIDER RAISING MORE BEFORE THE FLOP WHEN SHORT STACKED\",\n            \"suggestion38\": \"CONSIDER RAISING LESS BEFORE THE FLOP WHEN SHORT STACKED\",\n            \"suggestion39\": \"RAISE LESS PREFLOP WHEN SHORT STACKED\",\n            \"suggestion4\": \"RAISE MORE HANDS PREFLOP\",\n            \"suggestion40\": \"YOU MIGHT BE FOLDING TO MUCH IN THE EARLY GAME\",\n            \"suggestion41\": \"CONSIDER PLAYING MORE AGGRESSIVE IN THE EARLY GAME\",\n            \"suggestion42\": \"CONSIDER PLAYING LESS AGGRESSIVE IN THE EARLY GAME\",\n            \"suggestion43\": \"YOU MIGHT BE PLAYING TOO AGGRESSIVE IN THE EARLY GAME\",\n            \"suggestion44\": \"BE MINDFUL THAT LOW MULTIPLIER GAMES ARE STILL VERY IMPORTANT LONGTERM\",\n            \"suggestion45\": \"CONSIDER PLAYING LESS AGGRESSIVE IN LOW MULTIPLIER GAMES\",\n            \"suggestion46\": \"YOU MIGHT BE FOLDING TOO MUCH EITHER EARLY IN THE GAME OR WHEN HEADS UP\",\n            \"suggestion47\": \"CONSIDER PLAYING MORE AGGRESSIVE WHEN HEADS UP\",\n            \"suggestion48\": \"THE HANDS YOU ARE RAISING AND CALLING ALL-IN WITH ARE NOT STRONG ENOUGH\",\n            \"suggestion49\": \"CONSIDER AMENDING THE RANGE OF HANDS YOU ARE RAISING AND CALLING ALL IN WITH TO INCLUDE LESS HANDS\",\n            \"suggestion5\": \"CONSIDER RAISING MORE HANDS PREFLOP\",\n            \"suggestion50\": \"CONSIDER AMENDING THE RANGE OF HANDS YOU ARE RAISING AND CALLING ALL IN WITH TO INCLUDE MORE HANDS\",\n            \"suggestion51\": \"ITS OK TO BE ALLIN MORE OFTEN IN MARGINAL SITUATIONS\",\n            \"suggestion52\": \"Play tighter when you are one of the first players to act\",\n            \"suggestion6\": \"CONSIDER RAISING LESS HANDS PREFLOP\",\n            \"suggestion7\": \"RAISE LESS HANDS PREFLOP\",\n            \"suggestion8\": \"BET ON THE FLOP AFTER RASING PREFLOP MORE OFTEN\",\n            \"suggestion9\": \"CONSIDER BETTING ON THE FLOP AFTER RASING PREFLOP MORE OFTEN\",\n            \"texas\": {\n                \"genericUnlockInfo\": \"Unlocks after {0} hands in Texas Hold'em Cash Game (every month)\"\n            }\n        },\n        \"sectionName\": {\n            \"achievements\": \"Achievements\",\n            \"banzai20\": \"Banzai\",\n            \"hallOfFame\": \"Hall Of Fame\",\n            \"hexapro\": \"HexaPro\",\n            \"mtt\": \"MTT\",\n            \"school\": \"School\"\n        }\n    },\n    \"gameSelector\": {\n        \"cashGame\": {\n            \"banzai\": {\n                \"infoBubble\": \"Banzai Cash Game is the ultimate game if you like speed and action. Each player starting with just 10 big blinds, there\\u2019s never a dull moment! You are dealt 2 hole cards (your personal cards) and 5 shared community cards are dealt on the table.\"\n            },\n            \"banzai20\": {\n                \"infoBubble\": \"Battle your way through the ranks in our action packed Banzai cash games! Each players journey begins with 10 big blinds and the dream of becoming a Banzai Sensei. Earn new belts as you defeat your opponents in this quick-hitting variant of No Limit Texas Hold'em. Do you have what it takes to become a black belt?\"\n            },\n            \"omaha\": {\n                \"infoBubble\": \"In Pot Limit Omaha you are dealt 4 hole cards (your personal cards) and 5 community cards are dealt on the table. You need to use exactly 2 of your hole cards to form a poker hand. To play, simply enter a Cash Game pool with your preferred stakes.\"\n            },\n            \"texas\": {\n                \"infoBubble\": \"Join and leave the table whenever you want and play for cool cash. In No Limit Texas Hold\\u2019em you are dealt 2 hole cards (your personal cards) and 5 shared community cards are dealt on the table. To start, simply click PLAY at any Cash Game pool.\"\n            }\n        },\n        \"sng\": {\n            \"2seat\": {\n                \"infoBubble\": \"Fancy a quick heads up battle? The HU SNG tournament starts as soon as 2 players register. You get 1000 chips and blinds increase every 3 minutes. The game is Texas NLHE; you\\u2019re dealt 2 cards and 5 are dealt on the table.\"\n            },\n            \"5seat\": {\n                \"infoBubble\": \"The 5 seat SNG starts as soon as 5 players register. You get 1500 chips and the blinds increase every 3 minutes; top 2 players are paid. The game is Texas NLHE; you\\u2019re dealt 2 cards and 5 are dealt on the table.\"\n            }\n        }\n    },\n    \"handHistory\": {\n        \"balanceLabel\": \"Balance\",\n        \"banzaiHoldEm\": \"Banzai Texas\",\n        \"banzaiOmaha\": \"Banzai Omaha\",\n        \"challengeLabel\": \"Challenge\",\n        \"dateLabel\": \"Date\",\n        \"fromLabel\": \"From\",\n        \"gameTypeLabel\": \"Game type\",\n        \"handIdLabel\": \"Hand ID\",\n        \"idLabel\": \"ID\",\n        \"jpSngLabel\": \"HexaPro\",\n        \"majorLabel\": \"Major\",\n        \"minorLabel\": \"Minor\",\n        \"pointsLabel\": \"Points\",\n        \"potLabel\": \"Pot\",\n        \"tableTypeSelectorFilterPopup\": {\n            \"cashGame\": \"Cash Game\",\n            \"hexaPro\": \"HexaPro\",\n            \"sitAndGo\": \"Sit & Go\",\n            \"tournament\": \"Tournament\"\n        },\n        \"timeLabel\": \"Time ({timezone})\",\n        \"toLabel\": \"To\",\n        \"totalPointsLabel\": \"Total points\",\n        \"tournamentPointsLabel\": \"Tournament points\",\n        \"tradHoldEm\": \"Texas Hold'em\",\n        \"tradOmaha\": \"Omaha\",\n        \"typeLabel\": \"Type\"\n    },\n    \"handRankingPopup\": {\n        \"text\": {\n            \"combination0\": \"High Card\",\n            \"combination1\": \"A Pair\",\n            \"combination2\": \"Two Pairs\",\n            \"combination3\": \"Three of a Kind\",\n            \"combination4\": \"Straight\",\n            \"combination5\": \"Flush\",\n            \"combination6\": \"Full House\",\n            \"combination7\": \"Four of a Kind\",\n            \"combination8\": \"Straight Flush\",\n            \"combination9\": \"Royal Flush\"\n        }\n    },\n    \"headerBar\": {\n        \"balanceDialog\": {\n            \"balance\": \"Cash Balance\",\n            \"cashTickets\": \"Cash Tickets ({0})\",\n            \"deposit\": \"DEPOSIT\",\n            \"moneyInPlay\": \"Money in Play\",\n            \"restrictedBalance\": \"Restricted Win Balance\",\n            \"setDepositLimit\": \"SET DEPOSIT LIMIT\",\n            \"showBalance\": \"Show Balance\",\n            \"showBalanceDetailed\": \"Balance in lobby and buyin screens\",\n            \"tournamentTickets\": \"Tournament Tickets ({0})\",\n            \"withdraw\": \"WITHDRAW\"\n        },\n        \"lastLogin\": \"Last login:\",\n        \"notificationListPopup\": {\n            \"yourNotifications\": \"Your notifications\"\n        },\n        \"sessionTime\": \"Session time:\"\n    },\n    \"headerText\": {\n        \"32red\": \"32Red Poker\",\n        \"32rosu\": \"32Ro\\u0219u Poker\",\n        \"pokerihuone\": \"Pokerihuone\",\n        \"spilmedomtanke\": \"Play carefully\",\n        \"unibet\": \"Unibet Poker\"\n    },\n    \"hexaproBoost\": {\n        \"prize\": {\n            \"desc\": {\n                \"1\": \"Exclusive \\u20ac5,000 Flip Ticket\",\n                \"10\": \"\\u20ac2 UOS ticket\",\n                \"11\": \"\\u20ac5 UOS ticket\",\n                \"12\": \"\\u20ac10 UOS ticket\",\n                \"13\": \"\\u20ac25 UOS ticket\",\n                \"14\": \"\\u20ac50 UOS ticket\",\n                \"15\": \"\\u20ac100 UOS ticket\",\n                \"16\": \"\\u20ac250 UOS ticket\",\n                \"17\": \"Unibet Online Series Satellite Ticket\",\n                \"18\": \"\\u20ac1 Unibet Online Series Ticket\",\n                \"19\": \"\\u20ac2 Unibet Online Series Ticket\",\n                \"2\": \"BRONZE SANTA FLIP TOKEN\",\n                \"20\": \"\\u20ac5 Unibet Online Series Ticket\",\n                \"21\": \"\\u20ac10 Unibet Online Series Ticket\",\n                \"22\": \"\\u20ac25 Unibet Online Series Ticket\",\n                \"23\": \"\\u20ac50 Unibet Online Series Ticket\",\n                \"3\": \"SILVER SANTA FLIP TOKEN\",\n                \"4\": \"GOLD SANTA FLIP TOKEN\",\n                \"5\": \"SANTA BOOST BRONZE FREEROLL TICKET!\",\n                \"6\": \"SANTA BOOST SILVER FREEROLL TICKET!\",\n                \"7\": \"SANTA BOOST GOLD FREEROLL TICKET!\",\n                \"8\": \"Freeroll ticket\",\n                \"9\": \"\\u20ac1 UOS ticket\"\n            }\n        }\n    },\n    \"hexaproBoostPromoPopup\": {\n        \"text\": {\n            \"explanation\": \"Every time you get unlucky and get into a 1.5x multiplier in HexaPro you have a chance of getting a Boost before the first hand!\",\n            \"gamesTitle\": \"Eligible games:\",\n            \"gamesValue0\": \"HexaPro \\u20ac1 - \\u20ac2\",\n            \"gamesValue1\": \"HexaPro \\u20ac5\",\n            \"gamesValue2\": \"HexaPro \\u20ac10\",\n            \"info0\": \"Low tier\",\n            \"info1\": \"Mid tier\",\n            \"info2\": \"High tier\",\n            \"mainDescription\": \"Win UOS Tickets with UOS Boost if you get into a 1.5x HexaPro!\",\n            \"rewardValue0\": \"UOS Ticket up to \\u20ac25 value OR UOS Freeroll/Flip ticket\",\n            \"rewardValue1\": \"UOS Ticket up to \\u20ac100 value OR UOS Freeroll/Flip ticket\",\n            \"rewardValue2\": \"UOS Ticket up to \\u20ac100 value OR UOS Freeroll/Flip ticket\"\n        }\n    },\n    \"hexaproPromo\": {\n        \"banner\": {\n            \"nonMonetary\": {\n                \"infoText\": \"Jackpot Mania increases the chances of the high multiplier hitting at the highlighted stake\",\n                \"prizeActive\": \"Jackpot Mania active on\"\n            },\n            \"text\": {\n                \"buyIn\": \"{0} buy-in HexaPro games\",\n                \"buyInBanzai\": \"{0} buy-in HexaPro Banzai games\",\n                \"buyInExtreme\": \"{0} buy-in HexaPro Extreme games\",\n                \"buyInHexaPLOExtreme\": \"{0} buy-in HexaPLO Extreme games\",\n                \"mysteryJackpotStarts\": \"Mystery jackpot revealed in\",\n                \"prizepool\": \"prize pool guaranteed to go out within the next\"\n            }\n        },\n        \"text\": {\n            \"activeJpInfo\": \"{0} prize pool guaranteed within {1} games, on {2} buyin level in the Jackpot Mania - HexaPro promotion.\",\n            \"activeJpInfoWithGameType\": \"{0} prize pool guaranteed within {1} games, on {2} buyin level of {3} game in the Jackpot Mania promotion.\",\n            \"mysteryJackpotStartsSoonPlayAgainScreen\": \"Mystery Jackpot starts soon\",\n            \"nonMonetary\": {\n                \"notActive\": \"Daily guaranteed jackpots on HexaPro. Click below to check the promotions page for further info.\"\n            },\n            \"timeBased\": {\n                \"description\": \"Daily time-based jackpots running. Check the promotion page to find out about the times they are scheduled and more.\",\n                \"jackpotHitWithin\": \"{0} Jackpot on {1} {2} buyin must hit within:\",\n                \"nextJackpot\": \"Next jackpot starts in:\",\n                \"wc2022\": {\n                    \"description\": \"During each football match we will run Time based jackpots on HexaPro Extreme before, during half time and after the game! Up to 12 jackpots each day! Don't miss out on the action!\"\n                }\n            }\n        }\n    },\n    \"hexaproPromoPopup\": {\n        \"label\": {\n            \"header\": \"Jackpot Mania\",\n            \"headerTimeBased\": \"Time Based Jackpot\",\n            \"hexaproLobby\": \"HEXAPRO LOBBY\"\n        },\n        \"text\": {\n            \"activeItem\": \"{0} prize pool guaranteed within {1} {3} games on {2} buyin\",\n            \"completedItem\": \"{0} guaranteed {1} prize pools have been won\",\n            \"completedItemWithGameName\": \"{0} guaranteed {1} prize pools have been won in {2}\",\n            \"mysteryActivated\": \"Mystery Jackpot is being played out for\",\n            \"mysteryNotActiveItem\": \"Happy hours start every day at 15 and 19 CET! \",\n            \"mysteryNotActiveItemFr\": \"Happy hours start every day at 18 CEST! \",\n            \"pendingItem\": \"{0} prize pools pending in {1}\"\n        }\n    },\n    \"highrollerNights\": {\n        \"infoSegment0\": \"A unique chance to play High Stakes HexaPro and win up to \\u20ac625,000!\\nWe will open up \\u20ac250 HexaPro between 18:00 CEST - 02:00 CEST\",\n        \"infoSegment1\": \"Get ready to play high stakes Cash Game!\\nWe will open up a \\u20ac1,000 NL cash game pool (\\u20ac5 - \\u20ac10 blinds) between 18:00 CEST - 02:00 CEST\",\n        \"infoSegment2\": \"Are you ready to play our Highstakes tournaments ?\\nWe will run a \\u20ac40.000 guaranteed 250\\u20ac buy-in tournament on 6th April and a \\u20ac30.000 guaranteed 250\\u20ac buy-in tournament on 7th April at 20h00 CET\",\n        \"infoSegment3\": \"You love it on Friday, you will love it on Sunday and Monday. \\nWe will open up a 100\\u20ac Banzai table (blinds 10\\u20ac/20\\u20ac) between 18:00 CEST - 02:00 CEST\",\n        \"titleSegment0\": \"High Stakes Hexapro - \\u20ac250 buyin\",\n        \"titleSegment1\": \"High Stakes Cash Game - NL1000\",\n        \"titleSegment2\": \"High Stakes MTT - \\u20ac250 buyin\",\n        \"titleSegment3\": \"High Stakes Banzai - BZ100\"\n    },\n    \"hpExtraFeatureLottery\": {\n        \"text\": {\n            \"agreed\": \"Agreed\",\n            \"buyIn\": \"Buy-In\",\n            \"cancelFeature\": \"No, Thanks\",\n            \"currentPrizePool\": \"Current prizepool: {0}\",\n            \"description\": \"Make an EXTRA buy-in to increase the prize pool with an added multiplier! Valid only for the lowest multipliers (up to {0}X) and for {1} added attempts. All players have to agree. Final game will use the highest multiplier\\u00b4s rules.\",\n            \"extraBuyIn\": \"Extra Buy-In\",\n            \"playersAgreed\": \"{0}/3 players agreed\",\n            \"timeLeft\": \"Time left:\"\n        }\n    },\n    \"identityCreation\": {\n        \"aliasNotAvailableNotice\": \"This alias is not available. Try another one or pick one from the following suggestions:\",\n        \"aliasValidation\": {\n            \"aliasCantBeEmpty\": \"Alias can't be empty.\",\n            \"aliasInvalid\": \"Allowed characters for alias are a-z, A-Z, 0-9, - and _.\",\n            \"aliasTooLong\": \"Alias has to be 12 characters long or less.\",\n            \"aliasTooShort\": \"Alias has to be at least 2 characters long.\"\n        },\n        \"chooseAvatar\": \"Choose avatar\",\n        \"createAlias\": \"Create alias\",\n        \"createNewIdentity\": \"Create new identity\",\n        \"dailyLimitReachedNotice\": \"You have reached the limit of three identities per day. Come back tomorrow.\",\n        \"enterAlias\": \"Enter alias\",\n        \"finishButton\": \"Let's go!\",\n        \"hitTheTables\": \"Hit the tables\",\n        \"identityCreatedNoticeLong\": \"You\\u2019ve successfully created a new Poker identity. At the tables you will be now seen as {alias}.\",\n        \"identityCreatedNoticeShort\": \"Identity created.\",\n        \"identityInfoTexts\": {\n            \"aliasLengthInfo\": \"Alias length: 2-12 characters\",\n            \"currentIdentityInfo\": \"You currently have {count} poker identities.\",\n            \"currentIdentityInfo_0\": \"You currently have no poker identities.\",\n            \"currentIdentityInfo_1\": \"You currently have one poker identity.\",\n            \"currentIdentityInfo_2\": \"You currently have {count} poker identities.\",\n            \"currentIdentityInfo_3\": \"You currently have {count} poker identities.\",\n            \"currentIdentityInfo_4\": \"You currently have {count} poker identities.\",\n            \"currentIdentityInfo_5\": \"You already have the maximum number of identities (five).\",\n            \"identityAmountInfo\": \"You can have five different identities at a time and switch between them freely.\",\n            \"selectIdentityToReplace\": \"Please select an identity you want to replace:\",\n            \"supportedCharactersInfo\": \"Supported characters: a-z, A-Z, 0-9, - and _\"\n        },\n        \"invalidAliasNotice\": \"This alias is not available. Please try another one.\",\n        \"label\": {\n            \"extraIdentity\": \"Extra Identity\"\n        },\n        \"newAvatarLabel\": \"New\",\n        \"submit\": \"Submit\",\n        \"submitAvatar\": \"Submit avatar\"\n    },\n    \"identityCreationInfo\": {\n        \"chooseAvatar\": \"You can store up to five identities at once, and it\\u2019s easy to replace them\"\n    },\n    \"info\": {\n        \"1\": \"Developed by Relax Gaming Ltd.\\nCopyright 2025 Relax Gaming Ltd.\\nAll Rights Reserved.\",\n        \"2\": {\n            \"pokerihuone\": \"Pokerihuone uses Gloox Jabber/XMPP library software under a commercial license.\\nCopyright 2005-2017 Jacob Schr\\u00f6ter.\\nAll Rights Reserved.\",\n            \"unibet\": \"Unibet Poker uses Gloox Jabber/XMPP library software under a commercial license.\\nCopyright 2005-2017 Jacob Schr\\u00f6ter.\\nAll Rights Reserved.\"\n        },\n        \"3\": {\n            \"pokerihuone\": \"Pokerihuone uses Coherent Labs user interface technology.\\nCopyright 2012-2017 Coherent Labs.\\nAll Rights Reserved.\",\n            \"unibet\": \"Unibet Poker uses Coherent Labs user interface technology.\\nCopyright 2012-2017 Coherent Labs.\\nAll Rights Reserved.\"\n        },\n        \"4\": \"This product includes software developed by the OpenSSL Project for use in the OpenSSL Toolkit\",\n        \"cefLicense\": {\n            \"license\": \"License\",\n            \"short\": {\n                \"pokerihuone\": \"Pokerihuone uses Chromium Embedded Framework (CEF).\\nCopyright (c) 2008-2014 Marshall A. Greenblatt. Portions Copyright (c)\\n2006-2009 Google Inc. All rights reserved.\",\n                \"unibet\": \"Unibet Poker uses Chromium Embedded Framework (CEF).\\nCopyright (c) 2008-2014 Marshall A. Greenblatt. Portions Copyright (c)\\n2006-2009 Google Inc. All rights reserved.\"\n            },\n            \"title\": \"CEF License\"\n        },\n        \"emsLicense\": {\n            \"license\": \"License\",\n            \"short\": {\n                \"32Rosu\": \"32Rosu uses Emscripten.\\nCopyright (c) 2010-2014 Emscripten authors.\\nAll rights reserved.\",\n                \"32red\": \"32Red uses Emscripten.\\nCopyright (c) 2010-2014 Emscripten authors.\\nAll rights reserved.\",\n                \"pokerihuone\": \"Pokerihuone uses Emscripten.\\nCopyright (c) 2010-2014 Emscripten authors.\\nAll rights reserved.\",\n                \"unibet\": \"Unibet Poker uses Emscripten.\\nCopyright (c) 2010-2014 Emscripten authors.\\nAll rights reserved.\"\n            },\n            \"title\": \"Emscripten License\"\n        },\n        \"gplLicense\": {\n            \"license\": \"GPL-LICENSE\",\n            \"title\": \"GPL License\"\n        },\n        \"mitLicense\": {\n            \"license\": \"MIT-LICENSE\",\n            \"title\": \"MIT License\"\n        },\n        \"stropheLicense\": {\n            \"short\": {\n                \"32red\": \"32Red uses libstrophe XMPP client library\\nCopyright (C) 2005-2009 Collecta, Inc.\\nThis program is dual licensed under the MIT and GPLv3 licenses.\",\n                \"32rosu\": \"32Rosu uses libstrophe XMPP client library\\nCopyright (C) 2005-2009 Collecta, Inc.\\nThis program is dual licensed under the MIT and GPLv3 licenses.\",\n                \"pokerihuone\": \"Pokerihuone uses libstrophe XMPP client library\\nCopyright (C) 2005-2009 Collecta, Inc.\\nThis program is dual licensed under the MIT and GPLv3 licenses.\",\n                \"unibet\": \"Unibet Poker uses libstrophe XMPP client library\\nCopyright (C) 2005-2009 Collecta, Inc.\\nThis program is dual licensed under the MIT and GPLv3 licenses.\"\n            }\n        },\n        \"url\": \"http://www.openssl.org/\",\n        \"version\": \"Version {0}\"\n    },\n    \"interdictionFr\": {\n        \"infoPopup\": {\n            \"text\": {\n                \"description\": \"Toute personne peut demander \\u00e0 \\u00eatre interdite de jeux. Cette demande est form\\u00e9e aupr\\u00e8s de l'Autorit\\u00e9 nationale des jeux.\\n\\nCette interdiction est applicable dans les casinos, dans les clubs de jeux, sur les sites de jeux et de paris en ligne exploit\\u00e9s par les op\\u00e9rateurs de jeux agr\\u00e9\\u00e9s en France, sur le site de jeux de loterie en ligne exploit\\u00e9 par La Fran\\u00e7aise des jeux ainsi que sur les bornes de jeux accessibles avec un compte joueur exploit\\u00e9es par les op\\u00e9rateurs titulaires de droits exclusifs, notamment La Fran\\u00e7aise des jeux et le Pari mutuel urbain.\\n\\nCette interdiction est prononc\\u00e9e pour une dur\\u00e9e qui ne peut \\u00eatre inf\\u00e9rieure \\u00e0 trois ans. Elle est renouvelable tacitement. \"\n            }\n        },\n        \"text\": {\n            \"title\": \"INTERDICTION VOLONTAIRE DE JEUX\"\n        }\n    },\n    \"jpManiaTableNudge\": {\n        \"text\": {\n            \"hitWithing\": \"to be hit within\",\n            \"hitWithing2ndRow\": \"minutes on {0} {1} buyIn\",\n            \"hitWithing2ndRowHours\": \"hours on {0} {1} buyIn\"\n        }\n    },\n    \"jpSNGBlindsPanel\": {\n        \"label\": {\n            \"blinds\": \"BLINDS\",\n            \"next\": \"NEXT\"\n        }\n    },\n    \"jpSNGBuyInPopup\": {\n        \"label\": {\n            \"cash\": \"Cash\",\n            \"numberOfGames\": \"Number of games:\",\n            \"prizepool\": \"Prize pool:\",\n            \"register\": \"REGISTER\",\n            \"startingStack\": \"Chips (per table):\",\n            \"ticket\": \"Ticket\",\n            \"totalBuyIn\": \"Total Buy-in:\",\n            \"upTo\": \"up to\"\n        },\n        \"text\": {\n            \"minimumPayout\": \"2x minimum payout!\"\n        }\n    },\n    \"jpSNGMainSelectionView\": {\n        \"hexaproPromo\": {\n            \"infoBubleText\": \"Throughout the Jackpot Mania - HexaPro promotion, there will be a counter displaying within how many games the next Jackpot is guaranteed to hit.\"\n        },\n        \"menu\": {\n            \"Hexapro\": \"HEXAPRO\",\n            \"HoldEm\": \"TEXAS HOLD'EM\",\n            \"Info\": \"INFO\",\n            \"Omaha\": \"OMAHA\",\n            \"Promo\": \"PROMO\",\n            \"hexaproBanzai\": \"HEXAPRO BANZAI\"\n        },\n        \"pageInfo\": {\n            \"text\": {\n                \"hpUDSOInformation\": \"It's a special HexaPro where the lowest multiplier is a x2 and the biggest one is a Unibet Deepstack Open buy-in worth 550\\u20ac for the destination of your choice. The opportunity to qualify for a prestigious live events for only few euros\",\n                \"mainInformation\": \"HexaPro tournaments are played 3-handed. At the start of each HexaPro, a random draw will take place to set the prize pool. Play for prize pools up to 1000x your buy-in amount.\",\n                \"tournamentRules\": \"Tournament Rules\"\n            }\n        },\n        \"pagePromo\": {\n            \"text\": {\n                \"banzaiInformation\": \"HexaPro Banzai is an even faster version of our traditional HexaPro format. Experience the exciting prize lottery with up to 1000x your buy-in! You start with 300 chips and blind levels are 1 minute.\",\n                \"extremeInformation\": \"This is a faster and more adrenaline-filled HexaPro game. The lowest multiplier is 1x and the highest 1000x. The lowest multiplier doesn\\u2019t hit as often while the 125x hits more than 40 times as often as in Regular HexaPro. The starting stack ranges from 100 chips (5bb) to 500 chips (25bb) while the level up time ranges from 1 to 3 minutes. The lowest multiplier games are lighting fast while the biggest ones allow for a proper game of poker.\",\n                \"hexaPLOExtremeInformation\": \"This is an Omaha version of the adrenaline-filled HexaPro Extreme game. Just like the Texas version your starting stack ranges from 100 chips (5bb) to 500 chips (25bb) while the level up time ranges from 1 to 3 minutes. The lowest multiplier games are lighting fast while the biggest ones allow for a proper game of poker. Lowest multiplier is 1x and the highest 1000x. \",\n                \"mainInformation\": \"Don't miss out on any available HexaPro promotion. Find out what promotions are currently running, clicking the link below.\",\n                \"powerSpinFlashInformation\": \"Power Spin Flash is an even faster version of our traditional Power Spin format. Discover an even more intense experience! You start with 200 chips and blind levels are 1 minute.\",\n                \"powerSpinInformation\": \"Power Spin tournaments are played 3-handed. At the start of each Power Spin, a random draw will take place to set the prize pool. Play for prize pools up to 4000x your buy-in amount.\",\n                \"promotionsAvailable\": \"Promotions Available\"\n            }\n        },\n        \"pageSelectGame\": {\n            \"label\": {\n                \"buyIn\": \"BUY-IN\",\n                \"gameAvailableIn\": \"Game available in\",\n                \"gameType\": \"Game Type:\",\n                \"players\": \"Players in pool:\",\n                \"prizepoolUpTo\": \"PRIZE POOL UP TO\",\n                \"recentBigWins\": \"Recent big wins:\",\n                \"ticketsAvailable\": \"Tickets available:\"\n            }\n        }\n    },\n    \"leaderboard\": {\n        \"player\": \"Player\",\n        \"points\": \"Points\",\n        \"position\": \"Position\"\n    },\n    \"leaderboardsContextPage\": {\n        \"text\": {\n            \"yourPosition\": \"Your Position\"\n        }\n    },\n    \"leaderboardsDetailsPage\": {\n        \"text\": {\n            \"player\": \"Player\",\n            \"points\": \"Points\",\n            \"position\": \"Position\"\n        }\n    },\n    \"loadingScreen\": {\n        \"loading\": \"Loading...\"\n    },\n    \"loadingscreen\": {\n        \"remoteassets\": {\n            \"downloading\": \"Downloading assets, depending on connection this can take several minutes.\"\n        },\n        \"versionupdate\": {\n            \"downloading\": \"Client is updating to the latest version.\"\n        }\n    },\n    \"lobby\": {\n        \"devLogin\": {\n            \"login\": \"Relax Login\",\n            \"password\": \"Password\",\n            \"username\": \"Username\"\n        },\n        \"firstLoginView\": {\n            \"editBoxTip\": \"Enter your nickname, displayed at the table\",\n            \"error\": {\n                \"REGISTRATION_TIMEOUT\": \"Registration Timeout!\\nPlease login and try again!\"\n            },\n            \"infoText\": \"After signing in, you can change the avatar and create extra identities at any time. In Settings, you can change language and time zone.\"\n        },\n        \"historyView\": {\n            \"errorOccuried\": \"Error occurred unfortunately.\",\n            \"handId\": \"Hand Id\",\n            \"handIdNotFound\": \"Hand {0} not found.\",\n            \"holeCards\": \"Your cards\",\n            \"pot\": \"Pot\",\n            \"retrievingHandsData\": \"Retrieving Hands Data ...\",\n            \"retrievingHandsDetailsData\": \"Retrieving Hand Details Data ...\",\n            \"searchingHandId\": \"Searching Hand ...\",\n            \"tapMessageToContinue\": \"Tap message to continue.\",\n            \"time\": \"Time\",\n            \"winnings\": \"Winnings\"\n        },\n        \"navigationMenu\": {\n            \"version\": \"v.{0}\"\n        },\n        \"newFeatureInfoBalloon\": {\n            \"descFeature1\": \"Check out Game Lab - our new, exciting feature!\"\n        },\n        \"ticketsView\": {\n            \"expDayShort\": \"Exp. Date\",\n            \"expiresInLabel\": \"Expires In\",\n            \"expiresInLessDaysValue\": \"< {0} days\",\n            \"expiresInLessHoursValue\": \"< {0} h.\",\n            \"noAvailableTickets\": \"You don't have any tickets at this moment\"\n        },\n        \"tutorial\": {\n            \"aliasAvatarEtc\": \"Your alias and avatar,\\nbonus shop, hand history and more\",\n            \"doubleClickToStart\": \"Double click to start the game\",\n            \"doubleTapToStart\": \"Double tap to start the game\",\n            \"loyaltySystem\": \"Loyalty system\",\n            \"mainMenu\": \"Menu, Settings,\\nLanguage and more\",\n            \"notificationsBalance\": \"Notifications and balance\",\n            \"otherPromotionsMissions\": \"Other promotions and\\nmissions available today\",\n            \"promotion\": \"Promotion\",\n            \"selectGameFormat\": \"Select\\ngame format\",\n            \"selectGameType\": \"Select\\ngame type\",\n            \"selectStakeLevel\": \"Select\\nstake level\"\n        }\n    },\n    \"login\": {\n        \"32red\": {\n            \"title\": \"Log in\"\n        },\n        \"birthDate\": \"Enter your birthdate:\",\n        \"forgotPassword\": \"Forgot?\",\n        \"login\": \"Login\",\n        \"password\": \"Password\",\n        \"pokerihuone\": {\n            \"title\": \"Sign in with your Pokerihuone account\"\n        },\n        \"register\": \"Register\",\n        \"submit\": \"Submit\",\n        \"unibet\": {\n            \"title\": \"Log in\"\n        },\n        \"username\": \"Username\"\n    },\n    \"loyalty2026\": {\n        \"message\": {\n            \"restartapp\": \"From 1st of January 2026 there is a new Loyalty system, please restart the app to activate it.\"\n        },\n        \"text\": {\n            \"currentLevelPointsToNextExplanation\": \"You are Level {0} \\u2013 {1}. Collect {2} XP this quarter to reach level {3} - {4}.\",\n            \"currentLevelRetainedPointsExplanation\": \"You are Level {0} \\u2013 {1}. This quarter you need {2} XP to retain your level, and {3} XP to reach level {4} - {5}\",\n            \"currentLevelWithName\": \"Current level {0} - {1}\",\n            \"lastLevelKeepLevelExplanation\": \"You are Level {0} \\u2013 {1}. You will keep your level for next quarter as well\",\n            \"lastLevelRetainedPointsExplanation\": \"You are Level {0} \\u2013 {1}. This quarter you need {2} XP to retain your level.\",\n            \"nameLevel1\": \"Newbie\",\n            \"nameLevel2\": \"Challenger\",\n            \"nameLevel3\": \"Fighter\",\n            \"nameLevel4\": \"Prodigy\",\n            \"nameLevel5\": \"Champion\",\n            \"nameLevel6\": \"Master\",\n            \"nameLevel7\": \"Unreal\",\n            \"pointsToNextLevelWithName\": \"\"\n        }\n    },\n    \"mainMenu\": {\n        \"32red\": {\n            \"website\": \"32Red Site\"\n        },\n        \"32rosu\": {\n            \"website\": \"32Ro\\u0219u Site\"\n        },\n        \"about\": \"About\",\n        \"accountHistory\": \"Account History\",\n        \"cascadeWindows\": \"Stacked tables\",\n        \"community\": \"Community\",\n        \"contactUs\": \"Contact Us\",\n        \"editMyDetails\": \"Edit My Details\",\n        \"enterFullscreen\": \"Full screen\",\n        \"enterWindowMode\": \"Window Mode\",\n        \"handRanking\": \"Hand Ranking\",\n        \"help\": \"Help\",\n        \"language\": \"Language\",\n        \"lastLogin\": \"Last login\",\n        \"leaderboard\": \"Leaderboard\",\n        \"logout\": \"Logout\",\n        \"messages\": \"Messages\",\n        \"pokerNlSessionInfo\": \"Session Information\",\n        \"pokerRules\": \"Poker Rules\",\n        \"pokerihuone\": {\n            \"website\": \"Pokerihuone Site\"\n        },\n        \"privacyPolicy\": \"Privacy policy\",\n        \"promotions\": \"Promotions\",\n        \"responsibleGaming\": \"Responsible Gaming\",\n        \"settings\": \"Settings\",\n        \"tablesSingleView\": \"Single table view\",\n        \"tablesSplitView\": \"Split screen view\",\n        \"tablesTiling\": \"Tables Tiling\",\n        \"termsAndConditions\": \"Terms and Conditions\",\n        \"tournamentStatistics\": \"Tournament Statistics\",\n        \"unibet\": {\n            \"website\": \"Unibet Site\"\n        }\n    },\n    \"message\": {\n        \"ALREADY_AT_QUEUE\": \"You are already in queue\",\n        \"ALREADY_AT_TABLE\": \"Technical error #2, please try again later\",\n        \"ALREADY_REGISTERED\": \"You are already registered for this tournament\",\n        \"APIERROR\": \"Technical error #3, please try again later\",\n        \"APIERROR_17\": \"Blocked due to self exclusion. Customer needs to complete the positive action.\",\n        \"APIERROR_18\": \"Blocked due to self exclusion. Customer is in cooling off period.\",\n        \"BETLIMIT_NOT_SET\": \"Vous devez d\\u00e9finir votre limite de mise hebdomadaire pour lancer une partie.\\n D\\u00e9finir ma limite\",\n        \"BLACKLISTED\": \"This game is blocked for you\",\n        \"BLOCKED_FROM_PRODUCT\": \"You are blocked from playing. Please contact support. \",\n        \"BUYIN_INVALID_STATE\": \"Technical error #1, please try again later\",\n        \"CANNOT_MODIFY\": \"You will not be removed from the tournament until you are eliminated\",\n        \"CGTICKET_VALUE_TOO_SMALL\": \"Unfortunately, there's no money left on your ticket\",\n        \"ELIMINATED\": \"You have been eliminated from the tournament.\\nYou finished in position {0}.\",\n        \"FILTER_FAIL\": \"You do not meet the specific criteria to be able to participate in this tournament.\",\n        \"FR_TIMELIMIT_EXCEEDED\": \"You have reached your playing time limit.\",\n        \"FR_TIMELIMIT_NOT_SET\": \"Before any game operation, you must set playing time limit on your account at unibet.fr \",\n        \"IDLE_TIMEOUT\": \"You have been sitting out for too long. You have been removed from the table.\",\n        \"INSUFFICIENT_FUNDS\": \"Insufficient funds\",\n        \"INSUFFICIENT_FUNDS_FOR_ADDON\": \"Insufficient funds. Add-on declined\",\n        \"INSUFFICIENT_FUNDS_FOR_REBUY\": \"Insufficient funds. Re-buy declined\",\n        \"INSUFFICIENT_FUNDS_MAKE_DEPOSIT\": \"Insufficient funds. Do you want to make a deposit?\",\n        \"INVALID_AMOUNT\": \"Insufficient funds\",\n        \"LOGIN_LIMIT\": \"Login failed due to a large number of players. Please try again later.\",\n        \"LONE_RANGER\": \"Table is closed due to too few players. Do you want to open new table?\",\n        \"LONE_RANGER_TIMEOUT\": \"Table is now closed due to too few player. Time for other players to join has timed out. \",\n  